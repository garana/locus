#version 450

// Dense f32 matrix-vector product: o[r] = dot(w[r,:], x).
// One invocation per output row; correctness-first (M5 foundation),
// no shared-memory tiling yet.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer W { float w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer O { float o[]; };

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;  // float offset into O (e.g. a KV pool row)
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
} pc;

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.rows) {
        return;
    }
    float acc = 0.0;
    for (uint i = 0; i < pc.cols; ++i) {
        acc += w[pc.w_off + r * pc.cols + i] * x[pc.x_off + i];
    }
    uint at = pc.out_offset + r;
    float v = acc * pc.scale;
    o[at] = pc.accumulate != 0 ? o[at] + v : v;
}
