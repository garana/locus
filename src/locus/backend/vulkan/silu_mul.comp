#version 450

// SwiGLU activation: o = silu(gate) * up, elementwise. O may be
// the gate buffer itself (in-place). Grid-stride, so a prefill
// chunk's n can exceed 64 * 65535.
//
// With -DSIG_GATE (silu_mul_sg: qwen2moe's gated shared expert) each
// row of row_len outputs is also scaled by sigmoid(logit[row]), the
// row's 1-wide shared-expert gate projection.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer G { float g[]; };
layout(std430, binding = 1) readonly buffer U { float u[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };
#ifdef SIG_GATE
layout(std430, binding = 3) readonly buffer L { float logit[]; };
#endif

layout(push_constant) uniform PC {
    uint n;
#ifdef SIG_GATE
    uint row_len;
#endif
} pc;

void main() {
    uint step = gl_NumWorkGroups.x * 64u;
    for (uint i = gl_GlobalInvocationID.x; i < pc.n; i += step) {
        float v = g[i];
        float a = v / (1.0 + exp(-v)) * u[i];
#ifdef SIG_GATE
        a *= 1.0 / (1.0 + exp(-logit[i / pc.row_len]));
#endif
        o[i] = a;
    }
}
