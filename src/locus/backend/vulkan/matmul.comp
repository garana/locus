#version 450
#ifdef F16_STAGE
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// Tiled matmul for batched prefill: out[t][r] (+)= scale *
// dot(W row r, X row t) for n_tok token rows at once, so each weight
// tile is read once per BN tokens instead of once per token (the
// matvec path). One workgroup computes a BM x BN tile (weight rows x
// tokens): each K step stages BK dequantized weights per row and BK
// activations per token in shared memory, then every thread
// accumulates a TM x TN register block.
//
// Weight type by define: TYPE_Q8 (Q8_0 rows in the split GPU layout
// of q8_layout.hpp, byte offsets, cols % 32 == 0), TYPE_Q4K / TYPE_Q6K
// (ggml K-quant rows as on disk, byte offsets, cols % 256 == 0),
// TYPE_Q5_0 (ggml Q5_0 rows as on disk, byte offsets, cols % 32 == 0),
// TYPE_F16 / TYPE_BF16 (16-bit rows as on disk, offsets in elements)
// or TYPE_F32 (element offsets).
//
// TYPE_F32 can instead read W from the paged KV pool (attention as
// matmuls), through the block table at binding 3: PAGED makes row r
// cache position r (scores: S = K Q^T), PAGED_T makes column c cache
// position c (outputs: O = V^T P); w_off then offsets within a
// position's row_w-float cache row. With KV_F16 the pool holds IEEE
// halves in the same layout (offsets and strides count halves).
//
// With F16_STAGE (the *_h variants, opt-in --prefill-f16) both
// operands are staged in shared memory as f16 and widened back for
// f32 math: half the shared traffic, at f16 rounding of the
// dequantized weights and the activations (not bit-exact to f32).
//
// Split-K (k_splits > 1, decode attention: few output tiles, a long
// K): workgroup y also picks a slice ks of the K range and writes its
// partial sums to plane ks (split_stride floats apart) of the output,
// for sum_splits.comp to add up; accumulate is then ignored.
//
// Workgroup y = (b * tiles_n + tt) * k_splits + ks: batch b shifts
// the weight by
// (b / w_bdiv) * w_bstride and X and out by their *_bstride (MLA's
// per-head projections, or one query head per batch sharing its
// GQA K/V head), tt picks the token tile. Token t's X row is at
// x_off + (t / x_div) * x_stride + (t % x_div) * x_inner, its output
// row at out_off + (t / x_div) * out_stride + (t % x_div) * out_inner
// (x_div > 1: GQA attention, where a K/V head's query heads are
// extra token rows sharing each K/V tile).
//
// With MOE_ID, tiles_n holds n_expert and workgroup y picks entry y
// of the work list moe_group.comp appends to IDS (after
// counts[n_expert] and the n_expert lists of cap pair ids: a tile
// count, then expert << 16 | token tile per tile; y past the count
// exits). b is that expert and the token tile comes from its list;
// pair p reads X row p / x_div and writes output row p.

// 16 x 16 threads, each owning TM contiguous weight rows by TN
// contiguous tokens (both multiples of 4, read from shared memory as
// vec4s): the tile is BM = 16 TM rows by BN = 16 TN tokens, staged BK
// columns at a time (BK divides 32, so a K step never straddles a
// Q8_0 block).
#ifndef TM
#define TM 8u
#endif
#ifndef TN
#define TN 4u
#endif
#ifndef BK
// Columns staged per K step. BK16 selects the smaller-shared-memory
// tile for devices whose maxComputeSharedMemorySize cannot fit the
// default (16/32 must match kMatmulBKSmall/kMatmulBK in context.hpp).
// BK must divide 32 so a step never straddles a Q8_0 block.
#ifdef BK16
#define BK 16u
#else
#define BK 32u
#endif
#endif
#define BM (16u * TM)
#define BN (16u * TN)
// Weight values each thread stages per K step (whole uint words).
#define VPT (BM * BK / 256u)

layout(local_size_x = 256) in;

#if defined(TYPE_Q8) || defined(TYPE_Q4K) || defined(TYPE_Q6K) || \
    defined(TYPE_Q5_0)
#define W_BYTES
#endif
#if defined(TYPE_F16) || defined(TYPE_BF16)
#define W_HALF
#endif
#if defined(W_BYTES) || defined(KV_F16) || defined(W_HALF)
layout(std430, binding = 0) readonly buffer W { uint w[]; };
#if defined(TYPE_BF16) && !defined(PAGED) && !defined(PAGED_T)
// The same BF16 rows as 16-byte quads (8 weights), for whole-row stages.
layout(std430, binding = 0) readonly buffer W4 { uvec4 w4[]; };
#endif
#else
layout(std430, binding = 0) readonly buffer W { float w[]; };
#if defined(TYPE_F32) && !defined(PAGED) && !defined(PAGED_T) && \
    !defined(MOE_ID)
// The same F32 rows as vec4s, for whole-row stages.
layout(std430, binding = 0) readonly buffer W4F { vec4 w4f[]; };
#endif
#endif
layout(std430, binding = 1) readonly buffer X { float x[]; };
#if (defined(TYPE_BF16) || defined(TYPE_F32)) && !defined(PAGED) && \
    !defined(PAGED_T) && !defined(MOE_ID) && !defined(KV_F16)
// The same activations as vec4s, for whole, 16-byte-aligned stages.
layout(std430, binding = 1) readonly buffer X4 { vec4 x4[]; };
#endif
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef MOE_ID
layout(std430, binding = 3) readonly buffer IDS { uint ids[]; };
#endif
#if defined(PAGED) || defined(PAGED_T)
layout(std430, binding = 3) readonly buffer TABLE { uint table[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint n_tok;
    uint accumulate;
    uint w_off;       // bytes (quant) or elements (F32)
    uint x_off;
    uint x_stride;
    uint out_off;
    uint out_stride;
    float scale;
    uint w_bstride;   // per batch / expert, in w_off units
    uint x_bstride;
    uint out_bstride;
    uint tiles_n;     // token tiles per batch (y = b * tiles_n + tt);
                      // MOE_ID: n_expert
    uint x_div;       // MOE_ID: X row = pair / x_div
    uint cap;         // MOE_ID: list capacity per expert
    uint w_bdiv;      // batches per weight slice (GQA group), >= 1
    uint block_tokens;  // PAGED/PAGED_T: positions per block
    uint block_stride;  // floats per block
    uint row_w;         // floats per position's cache row
    uint k_splits;      // >= 1
    uint split_stride;  // floats between partial planes
    uint x_inner;       // x_div > 1 (not MOE_ID): see above
    uint out_inner;
#ifdef TYPE_Q8
    uint q8_gguf;       // 1: rows in GGUF's own block layout (i#678)
#endif
} pc;

#ifdef F16_STAGE
#define SVEC f16vec4
#define SVAL(v) float16_t(v)
#else
#define SVEC vec4
#define SVAL(v) (v)
#endif
shared SVEC ws[BK][BM / 4u];
shared SVEC xs[BK][BN / 4u];
shared uint rows_x[BN];
shared uint rows_o[BN];

#if defined(PAGED) || defined(PAGED_T)
/** Float offset of cache position p's row in the pool. */
uint pos_row(uint p) {
    return table[p / pc.block_tokens] * pc.block_stride +
           (p % pc.block_tokens) * pc.row_w;
}
#endif

#ifndef W_BYTES
#if defined(KV_F16) || defined(TYPE_F16)
/** Pool element i (a half). */
float w_el(uint i) {
    return unpackHalf2x16(w[i >> 1] >> ((i & 1u) * 16u)).x;
}
#elif defined(TYPE_BF16)
/** Element i (a bfloat16: the high half of an f32). */
float w_el(uint i) {
    uint v = w[i >> 1];
    return uintBitsToFloat((i & 1u) == 0u ? v << 16 : v & 0xffff0000u);
}
#else
#define w_el(i) w[i]
#endif

/** W element (row r, column c) of the slice at wbase. */
float w_at(uint wbase, uint r, uint c) {
#if defined(PAGED)
    return w_el(pos_row(r) + wbase + c);
#elif defined(PAGED_T)
    return w_el(pos_row(c) + wbase + r);
#else
    return w_el(wbase + r * pc.cols + c);
#endif
}
#endif

#ifdef W_BYTES
/** The 4 bytes at byte offset b (any alignment). */
uint word_at(uint b) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? w[i] : (w[i] >> sh) | (w[i + 1u] << (32u - sh));
}
#endif

#if defined(TYPE_Q4K) || defined(TYPE_Q6K) || defined(TYPE_Q5_0)
uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

float f16_at(uint i) {
    return unpackHalf2x16(byte_at(i) | (byte_at(i + 1u) << 8u)).x;
}
#endif

#ifdef TYPE_Q4K
// ggml get_scale_min_k4 over the packed scales at byte `sc0`.
void scale_min(uint j, uint sc0, out float d, out float m) {
    if (j < 4u) {
        d = float(byte_at(sc0 + j) & 63u);
        m = float(byte_at(sc0 + j + 4u) & 63u);
    } else {
        d = float((byte_at(sc0 + j + 4u) & 0xfu) |
                  ((byte_at(sc0 + j - 4u) >> 6u) << 4u));
        m = float((byte_at(sc0 + j + 4u) >> 4u) |
                  ((byte_at(sc0 + j) >> 6u) << 4u));
    }
}
#endif

#if (defined(TYPE_BF16) || defined(TYPE_F32)) && !defined(PAGED) && \
    !defined(PAGED_T) && !defined(MOE_ID) && !defined(KV_F16)
#define PREFETCH
#define XPT (BN * BK / 256u)
/**
 * The BF16 stage at k0 into registers: this thread's VPT weights of row
 * r (quad loads when whole and 16-byte aligned) and its XPT activations,
 * as the plain loop stages them, so the global loads of the next stage
 * can run while this one computes (i#592).
 */
void load_stage(uint k0, uint k_end, uint wbase, uint r, uint sub,
                uint tid, uint n_here, inout float wv[VPT],
                inout float xv[XPT]) {
    uint e0 = wbase + r * pc.cols + k0 + sub * VPT;
#ifdef TYPE_BF16
    if (r < pc.rows && k0 + sub * VPT + VPT <= k_end && (e0 & 7u) == 0u) {
        for (uint h = 0u; h < VPT / 8u; ++h) {
            uvec4 q = w4[(e0 >> 3) + h];
            for (uint i = 0u; i < 4u; ++i) {
                wv[h * 8u + 2u * i] = uintBitsToFloat(q[i] << 16);
                wv[h * 8u + 2u * i + 1u] =
                    uintBitsToFloat(q[i] & 0xffff0000u);
            }
        }
    } else {
#else
    if (r < pc.rows && k0 + sub * VPT + VPT <= k_end && (e0 & 3u) == 0u) {
        for (uint h = 0u; h < VPT / 4u; ++h) {
            vec4 q = w4f[(e0 >> 2) + h];
            wv[h * 4u] = q.x;
            wv[h * 4u + 1u] = q.y;
            wv[h * 4u + 2u] = q.z;
            wv[h * 4u + 3u] = q.w;
        }
    } else {
#endif
        for (uint c = 0u; c < VPT; ++c) {
            uint kc = k0 + sub * VPT + c;
            wv[c] = (r < pc.rows && kc < k_end) ? w_at(wbase, r, kc) : 0.0;
        }
    }
    // Activations: thread tid takes columns 4 (tid % (BK / 4)) .. + 4 of
    // token rows tid / (BK / 4) + j * (256 / (BK / 4)), one vec4 each
    // when the 4 columns are whole and the row 16-byte aligned.
    for (uint j = 0u; j < XPT / 4u; ++j) {
        uint idx = tid + j * 256u;
        uint tl = idx / (BK / 4u);
        uint c4 = (idx % (BK / 4u)) * 4u;
        uint kc = k0 + c4;
        uint at = tl < n_here ? rows_x[tl] + kc : 0u;
        if (tl < n_here && kc + 4u <= k_end && (at & 3u) == 0u) {
            vec4 v = x4[at >> 2];
            xv[4u * j] = v.x;
            xv[4u * j + 1u] = v.y;
            xv[4u * j + 2u] = v.z;
            xv[4u * j + 3u] = v.w;
        } else {
            for (uint i = 0u; i < 4u; ++i) {
                xv[4u * j + i] = (tl < n_here && kc + i < k_end)
                                     ? x[rows_x[tl] + kc + i]
                                     : 0.0;
            }
        }
    }
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ks = gl_WorkGroupID.y % pc.k_splits;
    uint yb = gl_WorkGroupID.y / pc.k_splits;
#ifdef MOE_ID
    uint lb = pc.tiles_n + pc.tiles_n * pc.cap;
    if (yb >= ids[lb]) {
        return;  // uniform: past the work list
    }
    uint ent = ids[lb + 1u + yb];
    uint b = ent >> 16;
    uint tt = ent & 0xffffu;
#else
    uint b = yb / pc.tiles_n;
    uint tt = yb % pc.tiles_n;
#endif
    // This split's K range, whole BK steps (Q8_0 blocks stay whole).
    uint k_per = ((pc.cols + pc.k_splits - 1u) / pc.k_splits + BK - 1u) /
                 BK * BK;
    uint k_begin = ks * k_per;
    uint k_end = min(pc.cols, k_begin + k_per);
    uint r0 = gl_WorkGroupID.x * BM;
    uint t0 = tt * BN;
    uint wbase = pc.w_off + (b / pc.w_bdiv) * pc.w_bstride;

#ifdef MOE_ID
    uint n_here = ids[b];
    if (t0 >= n_here) {
        return;  // uniform: this expert has no tokens in this tile
    }
    n_here = min(BN, n_here - t0);
    if (tid < n_here) {
        // Lists start after the n_expert counts.
        uint p = ids[pc.tiles_n + b * pc.cap + t0 + tid];
        rows_x[tid] = pc.x_off + (p / pc.x_div) * pc.x_stride;
        rows_o[tid] = pc.out_off + p * pc.out_stride;
    }
#else
    uint n_here = t0 < pc.n_tok ? min(BN, pc.n_tok - t0) : 0u;
    if (tid < BN) {
        uint t = t0 + tid;
        uint tq = t / pc.x_div;
        uint ti = t % pc.x_div;
        rows_x[tid] = pc.x_off + b * pc.x_bstride + tq * pc.x_stride +
                      ti * pc.x_inner;
        rows_o[tid] = pc.out_off + b * pc.out_bstride +
                      tq * pc.out_stride + ti * pc.out_inner;
    }
#endif
    barrier();

    // Compute layout: 16 x 16 threads; thread (tx, ty) owns rows
    // ty * TM .. + TM and tokens tx * TN .. + TN of the tile.
    uint tx = tid % 16u;
    uint ty = tid / 16u;
    vec4 acc[TM][TN / 4u];
    for (uint i = 0u; i < TM; ++i) {
        for (uint j = 0u; j < TN / 4u; ++j) {
            acc[i][j] = vec4(0.0);
        }
    }

    // Weight loader: BK / VPT threads per row, VPT values each.
    uint lr = tid / (BK / VPT);
    uint sub = tid % (BK / VPT);
#ifdef PREFETCH
    // Register-prefetched stages (i#592): stage k0 goes to shared memory
    // while stage k0 + BK's global loads are issued before the compute.
    float wv[VPT];
    float xv[XPT];
    uint rr = r0 + lr;
    if (k_begin < k_end) {
        load_stage(k_begin, k_end, wbase, rr, sub, tid, n_here, wv, xv);
    }
    for (uint k0 = k_begin; k0 < k_end; k0 += BK) {
        for (uint c = 0u; c < VPT; ++c) {
            ws[sub * VPT + c][lr / 4u][lr % 4u] = SVAL(wv[c]);
        }
        for (uint j = 0u; j < XPT / 4u; ++j) {
            uint idx = tid + j * 256u;
            uint tl = idx / (BK / 4u);
            uint c4 = (idx % (BK / 4u)) * 4u;
            for (uint i = 0u; i < 4u; ++i) {
                xs[c4 + i][tl / 4u][tl % 4u] = SVAL(xv[4u * j + i]);
            }
        }
        barrier();
        if (k0 + BK < k_end) {
            load_stage(k0 + BK, k_end, wbase, rr, sub, tid, n_here, wv, xv);
        }
        for (uint k = 0u; k < BK; ++k) {
            vec4 a[TM / 4u];
            vec4 bv[TN / 4u];
            for (uint i = 0u; i < TM / 4u; ++i) {
                a[i] = vec4(ws[k][ty * (TM / 4u) + i]);
            }
            for (uint j = 0u; j < TN / 4u; ++j) {
                bv[j] = vec4(xs[k][tx * (TN / 4u) + j]);
            }
            for (uint i = 0u; i < TM; ++i) {
                for (uint j = 0u; j < TN / 4u; ++j) {
                    acc[i][j] += a[i / 4u][i % 4u] * bv[j];
                }
            }
        }
        barrier();
    }
#else
    for (uint k0 = k_begin; k0 < k_end; k0 += BK) {
        // Weights: row r0 + lr, columns k0 + sub*8 .. +8.
        uint r = r0 + lr;
#ifdef TYPE_Q8
        if (r < pc.rows) {
            // Split GPU row layout (q8_layout.hpp): nb f16
            // scales, then nb x 32 quants; or, with q8_gguf (i#678),
            // GGUF's 34-byte blocks (an f16 scale, then 32 quants).
            uint nb = pc.cols / 32u;
            uint rb = wbase + r * nb * 34u;
            uint kc = k0 + sub * VPT;
            uint sa = pc.q8_gguf != 0u ? rb + (kc / 32u) * 34u
                                       : rb + (k0 / 32u) * 2u;
            float d = unpackHalf2x16(w[sa >> 2] >> ((sa & 2u) * 8u)).x;
            uint q0 = pc.q8_gguf != 0u ? sa + 2u + kc % 32u
                                       : rb + 2u * nb + kc;
            for (uint h = 0u; h < VPT / 4u; ++h) {
                int q = int(word_at(q0 + h * 4u));
                uint c = sub * VPT + h * 4u;
                ws[c][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 0, 8)));
                ws[c + 1u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 8, 8)));
                ws[c + 2u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 16, 8)));
                ws[c + 3u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 24, 8)));
            }
        } else {
            for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
                ws[c][lr / 4u][lr % 4u] = SVAL(0.0);
            }
        }
#elif defined(TYPE_Q4K) || defined(TYPE_Q6K)
        // A thread's VPT (8 or 16) columns, starting at a multiple of
        // VPT, sit in one Q4_K 32-column sub-block (one scale / min)
        // or one Q6_K 16-column group (one scale).
        if (r < pc.rows) {
            uint nb = pc.cols / 256u;
            uint kc = k0 + sub * VPT;
            uint e = kc % 256u;
#ifdef TYPE_Q4K
            uint at = wbase + (r * nb + kc / 256u) * 144u;
            uint sb = e / 32u;
            float sc, mn;
            scale_min(sb, at + 4u, sc, mn);
            float d1 = f16_at(at) * sc;
            float m1 = f16_at(at + 2u) * mn;
            uint q0 = at + 16u + (sb / 2u) * 32u + e % 32u;
            uint sh = (sb & 1u) * 4u;
            for (uint h = 0u; h < VPT / 4u; ++h) {
                uint v = word_at(q0 + h * 4u) >> sh;
                uint c = sub * VPT + h * 4u;
                for (uint i = 0u; i < 4u; ++i) {
                    ws[c + i][lr / 4u][lr % 4u] =
                        SVAL(d1 * float((v >> (8u * i)) & 0xfu) - m1);
                }
            }
#else
            // Half n of the block, quarter t (q1..q4 of matvec_q6_k),
            // l0 the first of the half's 32 lanes.
            uint at = wbase + (r * nb + kc / 256u) * 210u;
            uint n = e / 128u;
            uint t = (e % 128u) / 32u;
            uint l0 = e % 32u;
            float d1 = f16_at(at + 208u) *
                       float(bitfieldExtract(
                           int(byte_at(at + 192u + n * 8u + l0 / 16u +
                                       2u * t)),
                           0, 8));
            uint ql = at + n * 64u + (t & 1u) * 32u + l0;
            uint qh = at + 128u + n * 32u + l0;
            uint lsh = (t >> 1) * 4u;
            uint hsh = 2u * t;
            for (uint h = 0u; h < VPT / 4u; ++h) {
                uint lo = word_at(ql + h * 4u) >> lsh;
                uint hi = word_at(qh + h * 4u) >> hsh;
                uint c = sub * VPT + h * 4u;
                for (uint i = 0u; i < 4u; ++i) {
                    int q = int(((lo >> (8u * i)) & 0xfu) |
                                (((hi >> (8u * i)) & 3u) << 4u)) -
                            32;
                    ws[c + i][lr / 4u][lr % 4u] = SVAL(d1 * float(q));
                }
            }
#endif
        } else {
            for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
                ws[c][lr / 4u][lr % 4u] = SVAL(0.0);
            }
        }
#elif defined(TYPE_Q5_0)
        // A thread's VPT (8 or 16) columns sit in one half of a 22-byte
        // block (f16 d, u32 qh, 16 nibble bytes): element j < 16 is
        // qs[j]'s low nibble, j + 16 its high nibble, each with 5th bit
        // qh bit j (or j + 16), offset by -16 (matvec_q5_0).
        if (r < pc.rows) {
            uint nb = pc.cols / 32u;
            uint kc = k0 + sub * VPT;
            uint e = kc % 32u;
            uint at = wbase + (r * nb + kc / 32u) * 22u;
            float d = f16_at(at);
            uint qh = word_at(at + 2u) >> e;
            uint sh = e >= 16u ? 4u : 0u;
            uint q0 = at + 6u + e % 16u;
            for (uint c = 0u; c < VPT; ++c) {
                uint q = ((byte_at(q0 + c) >> sh) & 0xfu) |
                         (((qh >> c) & 1u) << 4u);
                ws[sub * VPT + c][lr / 4u][lr % 4u] =
                    SVAL(d * (float(q) - 16.0));
            }
        } else {
            for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
                ws[c][lr / 4u][lr % 4u] = SVAL(0.0);
            }
        }
#else
#if defined(TYPE_BF16) && !defined(PAGED) && !defined(PAGED_T)
        // A thread's VPT columns of one row as VPT / 8 quad loads, when
        // they are inside the tile and the row's elements start at a
        // multiple of 8 (16 bytes); else element by element. Same values
        // either way.
        uint e0 = wbase + r * pc.cols + k0 + sub * VPT;
        if (r < pc.rows && k0 + sub * VPT + VPT <= k_end &&
            (e0 & 7u) == 0u) {
            for (uint h = 0u; h < VPT / 8u; ++h) {
                uvec4 q = w4[(e0 >> 3) + h];
                uint c = sub * VPT + h * 8u;
                for (uint i = 0u; i < 4u; ++i) {
                    uint v = q[i];
                    ws[c + 2u * i][lr / 4u][lr % 4u] =
                        SVAL(uintBitsToFloat(v << 16));
                    ws[c + 2u * i + 1u][lr / 4u][lr % 4u] =
                        SVAL(uintBitsToFloat(v & 0xffff0000u));
                }
            }
        } else
#endif
        for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
            uint kc = k0 + c;
            ws[c][lr / 4u][lr % 4u] = SVAL((r < pc.rows && kc < k_end)
                                               ? w_at(wbase, r, kc)
                                               : 0.0);
        }
#endif
        // Activations: BN tokens x BK columns, strided over threads.
        for (uint idx = tid; idx < BN * BK; idx += 256u) {
            uint tl = idx / BK;
            uint c = idx % BK;
            uint kc = k0 + c;
            xs[c][tl / 4u][tl % 4u] = SVAL((tl < n_here && kc < k_end)
                                               ? x[rows_x[tl] + kc]
                                               : 0.0);
        }
        barrier();
        for (uint k = 0u; k < BK; ++k) {
            vec4 a[TM / 4u];
            vec4 bv[TN / 4u];
            for (uint i = 0u; i < TM / 4u; ++i) {
                a[i] = vec4(ws[k][ty * (TM / 4u) + i]);
            }
            for (uint j = 0u; j < TN / 4u; ++j) {
                bv[j] = vec4(xs[k][tx * (TN / 4u) + j]);
            }
            for (uint i = 0u; i < TM; ++i) {
                for (uint j = 0u; j < TN / 4u; ++j) {
                    acc[i][j] += a[i / 4u][i % 4u] * bv[j];
                }
            }
        }
        barrier();
    }
#endif

    for (uint j = 0u; j < TN; ++j) {
        uint tl = tx * TN + j;
        if (tl >= n_here) {
            continue;
        }
        for (uint i = 0u; i < TM; ++i) {
            uint r = r0 + ty * TM + i;
            if (r >= pc.rows) {
                continue;
            }
            uint at = rows_o[tl] + r + ks * pc.split_stride;
            float v = acc[i][j / 4u][j % 4u] * pc.scale;
            o[at] = pc.accumulate != 0u && pc.k_splits == 1u ? o[at] + v
                                                             : v;
        }
    }
}
