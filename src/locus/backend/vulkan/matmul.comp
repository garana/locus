#version 450
#ifdef F16_STAGE
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#endif

// Tiled matmul for batched prefill: out[t][r] (+)= scale *
// dot(W row r, X row t) for n_tok token rows at once, so each weight
// tile is read once per BN tokens instead of once per token (the
// matvec path). One workgroup computes a BM x BN tile (weight rows x
// tokens): each K step stages BK dequantized weights per row and BK
// activations per token in shared memory, then every thread
// accumulates a TM x TN register block.
//
// Weight type by define: TYPE_Q8 (Q8_0 rows in the split GPU layout
// of q8_layout.hpp, byte offsets, cols % 32 == 0) or TYPE_F32
// (element offsets).
//
// TYPE_F32 can instead read W from the paged KV pool (attention as
// matmuls), through the block table at binding 3: PAGED makes row r
// cache position r (scores: S = K Q^T), PAGED_T makes column c cache
// position c (outputs: O = V^T P); w_off then offsets within a
// position's row_w-float cache row. With KV_F16 the pool holds IEEE
// halves in the same layout (offsets and strides count halves).
//
// With F16_STAGE (the *_h variants, opt-in --prefill-f16) both
// operands are staged in shared memory as f16 and widened back for
// f32 math: half the shared traffic, at f16 rounding of the
// dequantized weights and the activations (not bit-exact to f32).
//
// Split-K (k_splits > 1, decode attention: few output tiles, a long
// K): workgroup y also picks a slice ks of the K range and writes its
// partial sums to plane ks (split_stride floats apart) of the output,
// for sum_splits.comp to add up; accumulate is then ignored.
//
// Workgroup y = (b * tiles_n + tt) * k_splits + ks: batch b shifts
// the weight by
// (b / w_bdiv) * w_bstride and X and out by their *_bstride (MLA's
// per-head projections, or one query head per batch sharing its
// GQA K/V head), tt picks the token tile. Token t's X row is at
// x_off + (t / x_div) * x_stride + (t % x_div) * x_inner, its output
// row at out_off + (t / x_div) * out_stride + (t % x_div) * out_inner
// (x_div > 1: GQA attention, where a K/V head's query heads are
// extra token rows sharing each K/V tile).
//
// With MOE_ID, b is an expert id and the token tile comes from that
// expert's list in IDS (moe_group.comp: counts[n_expert], then
// cap pair ids per expert); pair p reads X row p / x_div and writes
// output row p. An expert sees ~n_tok * k / n_expert pairs, so the
// MOE_ID token tile is 16 wide (a 64-token tile would multiply
// mostly padding).

// 16 x 16 threads, each owning TM contiguous weight rows by TN
// contiguous tokens (both multiples of 4, read from shared memory as
// vec4s): the tile is BM = 16 TM rows by BN = 16 TN tokens, staged BK
// columns at a time (BK divides 32, so a K step never straddles a
// Q8_0 block).
#ifndef TM
#define TM 8u
#endif
#ifndef TN
#define TN 4u
#endif
#ifndef BK
// Columns staged per K step. BK16 selects the smaller-shared-memory
// tile for devices whose maxComputeSharedMemorySize cannot fit the
// default (16/32 must match kMatmulBKSmall/kMatmulBK in context.hpp).
// BK must divide 32 so a step never straddles a Q8_0 block.
#ifdef BK16
#define BK 16u
#else
#define BK 32u
#endif
#endif
#define BM (16u * TM)
#define BN (16u * TN)
// Weight values each thread stages per K step (whole uint words).
#define VPT (BM * BK / 256u)

layout(local_size_x = 256) in;

#if defined(TYPE_Q8) || defined(KV_F16)
layout(std430, binding = 0) readonly buffer W { uint w[]; };
#else
layout(std430, binding = 0) readonly buffer W { float w[]; };
#endif
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef MOE_ID
layout(std430, binding = 3) readonly buffer IDS { uint ids[]; };
#endif
#if defined(PAGED) || defined(PAGED_T)
layout(std430, binding = 3) readonly buffer TABLE { uint table[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint n_tok;
    uint accumulate;
    uint w_off;       // bytes (Q8_0) or elements (F32)
    uint x_off;
    uint x_stride;
    uint out_off;
    uint out_stride;
    float scale;
    uint w_bstride;   // per batch / expert, in w_off units
    uint x_bstride;
    uint out_bstride;
    uint tiles_n;     // token tiles per batch (y = b * tiles_n + tt)
    uint x_div;       // MOE_ID: X row = pair / x_div
    uint cap;         // MOE_ID: list capacity per expert
    uint w_bdiv;      // batches per weight slice (GQA group), >= 1
    uint block_tokens;  // PAGED/PAGED_T: positions per block
    uint block_stride;  // floats per block
    uint row_w;         // floats per position's cache row
    uint k_splits;      // >= 1
    uint split_stride;  // floats between partial planes
    uint x_inner;       // x_div > 1 (not MOE_ID): see above
    uint out_inner;
} pc;

#ifdef F16_STAGE
#define SVEC f16vec4
#define SVAL(v) float16_t(v)
#else
#define SVEC vec4
#define SVAL(v) (v)
#endif
shared SVEC ws[BK][BM / 4u];
shared SVEC xs[BK][BN / 4u];
shared uint rows_x[BN];
shared uint rows_o[BN];

#if defined(PAGED) || defined(PAGED_T)
/** Float offset of cache position p's row in the pool. */
uint pos_row(uint p) {
    return table[p / pc.block_tokens] * pc.block_stride +
           (p % pc.block_tokens) * pc.row_w;
}
#endif

#ifndef TYPE_Q8
#ifdef KV_F16
/** Pool element i (a half). */
float w_el(uint i) {
    return unpackHalf2x16(w[i >> 1] >> ((i & 1u) * 16u)).x;
}
#else
#define w_el(i) w[i]
#endif

/** W element (row r, column c) of the slice at wbase. */
float w_at(uint wbase, uint r, uint c) {
#if defined(PAGED)
    return w_el(pos_row(r) + wbase + c);
#elif defined(PAGED_T)
    return w_el(pos_row(c) + wbase + r);
#else
    return w[wbase + r * pc.cols + c];
#endif
}
#endif

#ifdef TYPE_Q8
/** The 4 bytes at byte offset b (any alignment). */
uint word_at(uint b) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? w[i] : (w[i] >> sh) | (w[i + 1u] << (32u - sh));
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint ks = gl_WorkGroupID.y % pc.k_splits;
    uint yb = gl_WorkGroupID.y / pc.k_splits;
    uint b = yb / pc.tiles_n;
    uint tt = yb % pc.tiles_n;
    // This split's K range, whole BK steps (Q8_0 blocks stay whole).
    uint k_per = ((pc.cols + pc.k_splits - 1u) / pc.k_splits + BK - 1u) /
                 BK * BK;
    uint k_begin = ks * k_per;
    uint k_end = min(pc.cols, k_begin + k_per);
    uint r0 = gl_WorkGroupID.x * BM;
    uint t0 = tt * BN;
    uint wbase = pc.w_off + (b / pc.w_bdiv) * pc.w_bstride;

#ifdef MOE_ID
    uint n_here = ids[b];
    if (t0 >= n_here) {
        return;  // uniform: this expert has no tokens in this tile
    }
    n_here = min(BN, n_here - t0);
    if (tid < n_here) {
        // Lists start after the n_expert counts; the grid has
        // n_expert * tiles_n workgroups in y.
        uint n_exp = gl_NumWorkGroups.y / (pc.tiles_n * pc.k_splits);
        uint p = ids[n_exp + b * pc.cap + t0 + tid];
        rows_x[tid] = pc.x_off + (p / pc.x_div) * pc.x_stride;
        rows_o[tid] = pc.out_off + p * pc.out_stride;
    }
#else
    uint n_here = t0 < pc.n_tok ? min(BN, pc.n_tok - t0) : 0u;
    if (tid < BN) {
        uint t = t0 + tid;
        uint tq = t / pc.x_div;
        uint ti = t % pc.x_div;
        rows_x[tid] = pc.x_off + b * pc.x_bstride + tq * pc.x_stride +
                      ti * pc.x_inner;
        rows_o[tid] = pc.out_off + b * pc.out_bstride +
                      tq * pc.out_stride + ti * pc.out_inner;
    }
#endif
    barrier();

    // Compute layout: 16 x 16 threads; thread (tx, ty) owns rows
    // ty * TM .. + TM and tokens tx * TN .. + TN of the tile.
    uint tx = tid % 16u;
    uint ty = tid / 16u;
    vec4 acc[TM][TN / 4u];
    for (uint i = 0u; i < TM; ++i) {
        for (uint j = 0u; j < TN / 4u; ++j) {
            acc[i][j] = vec4(0.0);
        }
    }

    // Weight loader: BK / VPT threads per row, VPT values each.
    uint lr = tid / (BK / VPT);
    uint sub = tid % (BK / VPT);
    for (uint k0 = k_begin; k0 < k_end; k0 += BK) {
        // Weights: row r0 + lr, columns k0 + sub*8 .. +8.
        uint r = r0 + lr;
#ifdef TYPE_Q8
        if (r < pc.rows) {
            // Split GPU row layout (q8_layout.hpp): nb f16
            // scales, then nb x 32 quants.
            uint nb = pc.cols / 32u;
            uint rb = wbase + r * nb * 34u;
            uint sa = rb + (k0 / 32u) * 2u;
            float d = unpackHalf2x16(w[sa >> 2] >> ((sa & 2u) * 8u)).x;
            uint q0 = rb + 2u * nb + k0 + sub * VPT;
            for (uint h = 0u; h < VPT / 4u; ++h) {
                int q = int(word_at(q0 + h * 4u));
                uint c = sub * VPT + h * 4u;
                ws[c][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 0, 8)));
                ws[c + 1u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 8, 8)));
                ws[c + 2u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 16, 8)));
                ws[c + 3u][lr / 4u][lr % 4u] =
                    SVAL(d * float(bitfieldExtract(q, 24, 8)));
            }
        } else {
            for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
                ws[c][lr / 4u][lr % 4u] = SVAL(0.0);
            }
        }
#else
        for (uint c = sub * VPT; c < sub * VPT + VPT; ++c) {
            uint kc = k0 + c;
            ws[c][lr / 4u][lr % 4u] = SVAL((r < pc.rows && kc < k_end)
                                               ? w_at(wbase, r, kc)
                                               : 0.0);
        }
#endif
        // Activations: BN tokens x BK columns, strided over threads.
        for (uint idx = tid; idx < BN * BK; idx += 256u) {
            uint tl = idx / BK;
            uint c = idx % BK;
            uint kc = k0 + c;
            xs[c][tl / 4u][tl % 4u] = SVAL((tl < n_here && kc < k_end)
                                               ? x[rows_x[tl] + kc]
                                               : 0.0);
        }
        barrier();
        for (uint k = 0u; k < BK; ++k) {
            vec4 a[TM / 4u];
            vec4 bv[TN / 4u];
            for (uint i = 0u; i < TM / 4u; ++i) {
                a[i] = vec4(ws[k][ty * (TM / 4u) + i]);
            }
            for (uint j = 0u; j < TN / 4u; ++j) {
                bv[j] = vec4(xs[k][tx * (TN / 4u) + j]);
            }
            for (uint i = 0u; i < TM; ++i) {
                for (uint j = 0u; j < TN / 4u; ++j) {
                    acc[i][j] += a[i / 4u][i % 4u] * bv[j];
                }
            }
        }
        barrier();
    }

    for (uint j = 0u; j < TN; ++j) {
        uint tl = tx * TN + j;
        if (tl >= n_here) {
            continue;
        }
        for (uint i = 0u; i < TM; ++i) {
            uint r = r0 + ty * TM + i;
            if (r >= pc.rows) {
                continue;
            }
            uint at = rows_o[tl] + r + ks * pc.split_stride;
            float v = acc[i][j / 4u][j % 4u] * pc.scale;
            o[at] = pc.accumulate != 0u && pc.k_splits == 1u ? o[at] + v
                                                             : v;
        }
    }
}
