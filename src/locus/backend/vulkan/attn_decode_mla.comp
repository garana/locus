#version 450

// Flash-decoding attention for one query token over MLA's shared
// latent rows: every head attends to the same [latent | k_pe] row per
// position, so a workgroup takes CH positions for HG heads at once and
// reads each row once for all of them (attn_decode.comp reads it once
// per head). Workgroup (x = position block c, y = head group).
//
// Scores: s[h][p] = q1[h] . key[p][0, d1) + q2[h] . key[p][d1, d1 +
// d2), with key at pool[row + k_off]. V is the first dv floats of the
// key (the latent itself). With one block it writes o / l to OUT;
// otherwise (o, m, l) partials in attn_combine.comp's layout.
//
// The host dispatches only when dv % 4 == 0, dv / 4 <= WG / 2 and the
// row bases are 4-float aligned (vec4 latent loads).

#define WG 256u
#define CH 32u              // positions per block
#define HG 16u              // heads per workgroup
#define HP (WG / CH)        // head lanes per position (scores)
#define HACC 8u             // max heads per thread (weighted V)
#define KC 32u              // key floats per staged chunk

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer POOL { float pool[]; };
layout(std430, binding = 0) readonly buffer POOL4 { vec4 pool4[]; };
layout(std430, binding = 1) readonly buffer TABLE { uint table[]; };
layout(std430, binding = 2) readonly buffer Q1 { float q1[]; };
layout(std430, binding = 3) readonly buffer Q2 { float q2[]; };
layout(std430, binding = 4) writeonly buffer OUT { float o[]; };
layout(std430, binding = 5) writeonly buffer PART { float part[]; };

layout(push_constant) uniform PC {
    uint n_pos;
    uint block_tokens;
    uint block_stride;  // floats per pool block
    uint row_w;         // floats per position row
    uint k_off;         // floats into a row: key (= latent) start
    uint heads;
    uint d1;
    uint d2;
    uint q1_stride;
    uint q2_stride;
    uint q2_off;
    uint dv;
    float scale;
    uint out_stride;    // OUT floats between heads
} pc;

shared float sc[HG * CH];
shared float mh[HG];
shared float lh[HG];
shared uint rowb[CH];
shared float qs[HG * KC];
shared float ks[CH * (KC + 1u)];

void main() {
    uint t = gl_LocalInvocationID.x;
    uint c = gl_WorkGroupID.x;
    uint h0 = gl_WorkGroupID.y * HG;
    uint n_blocks = gl_NumWorkGroups.x;
    uint nh = min(HG, pc.heads - h0);
    uint p0 = c * CH;
    uint np = min(CH, pc.n_pos - p0);
    if (t < np) {
        uint p = p0 + t;
        rowb[t] = table[p / pc.block_tokens] * pc.block_stride +
                  (p % pc.block_tokens) * pc.row_w + pc.k_off;
    }
    barrier();

    // Scores, a small GEMM over KC-float chunks of the key staged in
    // shared memory (loads run along the key, so they coalesce):
    // thread (position lp, head lane hl) takes heads hl, hl + HP, ...
    uint lp = t % CH;
    uint hl = t / CH;
    uint dk = pc.d1 + pc.d2;
    float s[HG / HP];
    for (uint j = 0u; j < HG / HP; ++j) {
        s[j] = 0.0;
    }
    // Each chunk's global loads are issued into registers before the
    // previous chunk is consumed (double buffering through rq / rk).
    float rq[HG * KC / WG];
    float rk[CH * KC / WG];
    for (uint k0 = 0u; k0 < dk + KC; k0 += KC) {
        if (k0 > 0u) {
            for (uint u = 0u; u < HG * KC / WG; ++u) {
                qs[t + u * WG] = rq[u];
            }
            for (uint u = 0u; u < CH * KC / WG; ++u) {
                uint e = t + u * WG;
                ks[(e / KC) * (KC + 1u) + e % KC] = rk[u];
            }
            barrier();
        }
        if (k0 < dk) {
            for (uint u = 0u; u < HG * KC / WG; ++u) {
                uint e = t + u * WG;
                uint i = k0 + e % KC;
                uint h = min(h0 + e / KC, pc.heads - 1u);
                rq[u] = i < pc.d1 ? q1[h * pc.q1_stride + i]
                      : i < dk    ? q2[h * pc.q2_stride + pc.q2_off + i -
                                       pc.d1]
                                  : 0.0;
            }
            for (uint u = 0u; u < CH * KC / WG; ++u) {
                uint e = t + u * WG;
                uint p = e / KC;
                uint i = k0 + e % KC;
                rk[u] = p < np && i < dk ? pool[rowb[p] + i] : 0.0;
            }
        }
        if (k0 > 0u) {
            for (uint i = 0u; i < KC; ++i) {
                float kv = ks[lp * (KC + 1u) + i];
                for (uint j = 0u; j < HG / HP; ++j) {
                    s[j] += qs[(hl + j * HP) * KC + i] * kv;
                }
            }
            barrier();
        }
    }
    for (uint j = 0u; j < HG / HP; ++j) {
        sc[(hl + j * HP) * CH + lp] =
            lp < np ? s[j] * pc.scale : -3.4e38;
    }
    barrier();
    if (t < HG) {
        float m = -3.4e38;
        for (uint p = 0u; p < np; ++p) {
            m = max(m, sc[t * CH + p]);
        }
        mh[t] = m;
    }
    barrier();
    {
        uint hh = t / CH;
        for (uint j = 0u; j < HG / HP; ++j) {
            uint i = (hh + j * HP) * CH + lp;
            sc[i] = lp < np ? exp(sc[i] - mh[hh + j * HP]) : 0.0;
        }
    }
    barrier();
    if (t < HG) {
        float l = 0.0;
        for (uint p = 0u; p < np; ++p) {
            l += sc[t * CH + p];
        }
        lh[t] = l;
    }
    barrier();

    // Weighted V: thread (vec4 column d4, head set hs) accumulates
    // its 4 latent columns for heads hs * hps .. + hps, each latent
    // vec4 loaded once for all of them.
    uint n4 = pc.dv / 4u;
    uint hsets = WG / n4;
    uint hps = (HG + hsets - 1u) / hsets;
    uint d4 = t % n4;
    uint hs = t / n4;
    if (hs >= hsets || hps > HACC) {
        return;
    }
    vec4 acc[HACC];
    for (uint j = 0u; j < HACC; ++j) {
        acc[j] = vec4(0.0);
    }
    // Constant trip counts (guards inside) keep acc in registers.
    for (uint p = 0u; p < np; ++p) {
        vec4 v = pool4[(rowb[p] >> 2) + d4];
        for (uint j = 0u; j < HACC; ++j) {
            uint hh = min(hs * hps + j, HG - 1u);
            acc[j] += sc[hh * CH + p] * v;
        }
    }
    uint heads = pc.heads;
    for (uint j = 0u; j < HACC; ++j) {
        uint hh = hs * hps + j;
        if (j >= hps || hh >= nh) {
            continue;
        }
        uint h = h0 + hh;
        if (n_blocks == 1u) {
            vec4 r = acc[j] / lh[hh];
            uint ob = h * pc.out_stride + d4 * 4u;
            o[ob] = r.x;
            o[ob + 1u] = r.y;
            o[ob + 2u] = r.z;
            o[ob + 3u] = r.w;
        } else {
            uint pb = (c * heads + h) * pc.dv + d4 * 4u;
            part[pb] = acc[j].x;
            part[pb + 1u] = acc[j].y;
            part[pb + 2u] = acc[j].z;
            part[pb + 3u] = acc[j].w;
            if (d4 == 0u) {
                uint st = n_blocks * heads * pc.dv + (c * heads + h) * 2u;
                part[st] = mh[hh];
                part[st + 1u] = lh[hh];
            }
        }
    }
}
