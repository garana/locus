#version 450

// RMS norm: out[out_off + i] = x[i] * w[i] / sqrt(mean+eps),
// over the first n elements of X. One workgroup: threads stride the
// elements and the sum of squares is reduced in shared memory. The
// next `tail` elements are copied through unchanged (MLA's k_pe after
// the normed latent: one dispatch instead of a norm and a copy).
//
// Compiled again with -DBATCHED (rmsnorm_b): workgroup y normalizes
// row y, read at in_off + y * in_stride and written at out_off +
// y * out_stride (a prefill chunk's rows in one dispatch).

#define WG 256u

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer W { float w[]; };
layout(std430, binding = 2) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC {
    uint n;
    float eps;
    uint out_off;
#ifdef BATCHED
    uint in_off;
    uint in_stride;
    uint out_stride;
#else
    uint tail;
#endif
} pc;

shared float red[WG];

void main() {
    uint tid = gl_LocalInvocationID.x;
#ifdef BATCHED
    uint xi = pc.in_off + gl_WorkGroupID.y * pc.in_stride;
    uint oi = pc.out_off + gl_WorkGroupID.y * pc.out_stride;
#else
    uint xi = 0u;
    uint oi = pc.out_off;
#endif
    float ss = 0.0;
    for (uint i = tid; i < pc.n; i += WG) {
        ss += x[xi + i] * x[xi + i];
    }
    red[tid] = ss;
    barrier();
    for (uint step = WG / 2u; step > 0u; step >>= 1) {
        if (tid < step) {
            red[tid] += red[tid + step];
        }
        barrier();
    }
    float scale = inversesqrt(red[0] / float(pc.n) + pc.eps);
    for (uint i = tid; i < pc.n; i += WG) {
        o[oi + i] = x[xi + i] * scale * w[i];
    }
#ifndef BATCHED
    for (uint i = pc.n + tid; i < pc.n + pc.tail; i += WG) {
        o[oi + i] = x[xi + i];
    }
#endif
}
