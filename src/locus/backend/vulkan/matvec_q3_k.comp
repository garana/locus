#version 450

// Q3_K matvec: 110-byte super-blocks of 256 elements -- hmask[32] |
// qs[64] | scales[12] | f16 d. Element value d * (scale - 32) * (2-bit
// quant - (high bit clear ? 4 : 0)), a 6-bit scale per 16 elements
// (mirrors cpu_ops dequant_block_q3_k). As matvec_q5_0: ROWS rows a
// workgroup, LANES lanes a row, each lane taking 16-element groups.
//
// Compiled a second time with -DBATCHED (matvec_q3_k_b) with matvec_q5_0's
// slot semantics: slot y reads w_off + id * w_stride (bytes), x_off +
// y * x_stride and writes out_offset + y * out_stride, id = route[y]
// under mode bit 1; mode bit 2 sums all slots weighted by
// route[n_slots + k] into one output row.

#define LANES 32u
#define ROWS 4u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef BATCHED
layout(std430, binding = 3) readonly buffer R { uint route[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // byte offset
    uint x_off;
    float scale;
#ifdef BATCHED
    uint w_stride;  // per slot, in bytes
    uint x_stride;
    uint out_stride;
    uint n_slots;
    uint mode;      // 1 = ids from route[], 2 = weighted slot sum
    uint row_stride;  // unused (quantized rows are whole)
#endif
} pc;

shared float red[LANES * ROWS];

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

float f16_at(uint i) {
    return unpackHalf2x16(byte_at(i) | (byte_at(i + 1u) << 8u)).x;
}

/** Group is's 6-bit scale (0..15) of the block at `at`, minus 32. */
int scale_of(uint at, uint is) {
    uint i = is & 3u;
    uint grp = is >> 2;
    uint b = byte_at(at + 96u + (grp & 1u) * 4u + i);
    uint lo = grp < 2u ? (b & 0xfu) : (b >> 4);
    uint hi = (byte_at(at + 104u + i) >> (2u * grp)) & 3u;
    return int(lo | (hi << 4)) - 32;
}

/** This lane's share of dot(row r of the matrix at wbase, x). */
float row_part(uint wbase, uint xbase, uint r, uint lane) {
    uint nb = pc.cols / 256u;
    uint base = wbase + r * nb * 110u;
    float acc = 0.0;
    // Unit u: 16-element group is of block b. Group is covers half
    // n = is / 8 (128 elements), quant shift 2 * ((is % 8) / 2) and
    // the 16 bytes from (is % 2) * 16; its high bit is bit 4n + j of
    // hmask.
    for (uint u = lane; u < nb * 16u; u += LANES) {
        uint b = u >> 4;
        uint is = u & 15u;
        uint at = base + b * 110u;
        uint n = is >> 3;
        uint j = (is & 7u) >> 1;
        uint half16 = (is & 1u) * 16u;
        uint shift = 2u * j;
        uint m = 1u << (n * 4u + j);
        uint qb = at + 32u + n * 32u + half16;
        uint hb = at + half16;
        uint xb = xbase + b * 256u + n * 128u + j * 32u + half16;
        float s = 0.0;
        for (uint l = 0u; l < 16u; ++l) {
            int q = int((byte_at(qb + l) >> shift) & 3u) -
                    ((byte_at(hb + l) & m) != 0u ? 0 : 4);
            s += float(q) * x[xb + l];
        }
        acc += f16_at(at + 108u) * float(scale_of(at, is)) * s;
    }
    return acc;
}

void main() {
    uint lane = gl_LocalInvocationID.x % LANES;
    uint slot = gl_LocalInvocationID.x / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint at = pc.out_offset + r;
    float acc = 0.0;
    if (r < pc.rows) {
#ifdef BATCHED
        uint y = gl_WorkGroupID.y;
        bool sum = (pc.mode & 2u) != 0u;
        uint k1 = sum ? pc.n_slots : y + 1u;
        for (uint k = sum ? 0u : y; k < k1; ++k) {
            uint id = (pc.mode & 1u) != 0u ? route[k] : k;
            float wk = sum ? uintBitsToFloat(route[pc.n_slots + k])
                           : 1.0;
            acc += wk * row_part(pc.w_off + id * pc.w_stride,
                                 pc.x_off + k * pc.x_stride, r, lane);
        }
        if (!sum) {
            at += y * pc.out_stride;
        }
#else
        acc = row_part(pc.w_off, pc.x_off, r, lane);
#endif
    }
    red[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            red[gl_LocalInvocationID.x] +=
                red[gl_LocalInvocationID.x + step];
        }
        barrier();
    }
    if (lane == 0u && r < pc.rows) {
        float v = red[gl_LocalInvocationID.x] * pc.scale;
        o[at] = pc.accumulate != 0 ? o[at] + v : v;
    }
}
