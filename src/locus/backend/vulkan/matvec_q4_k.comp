#version 450

// Q4_K matvec (and Q3_K with -DTYPE_Q3K, see below): 144-byte
// super-blocks of 256 elements -- f16 d and
// dmin, 12 packed 6-bit scale/min pairs, 128 nibble bytes. Sub-block
// s = 2j + h (h = 0 low nibbles, 1 high) of super-block b covers the
// 32 elements 64j + 32h .. of the block, from bytes 32j .. 32j + 31.
//
// Eight rows per workgroup, 16 lanes per row: lanes stride over the
// row's sub-block pairs 2j, 2j + 1, which share their 32 nibble bytes
// (low and high nibbles), so each byte is loaded once. A lane reads
// the block header (d, dmin, scales) and its nibbles as three 16-byte
// loads when the slot's weights start 16-byte aligned (word loads
// otherwise), decodes nibbles two at a time through an f16 mantissa,
// loads activations as vec4s, and adds d*sc*sum(q*x) - dmin*m*sum(x)
// per sub-block; a shared-memory tree reduces the row.
//
// Compiled again with -DBATCHED (matvec_q4_k_b): slots as in
// matvec_q8_0.comp -- slot y reads w_off + id * w_stride (bytes) and
// x_off + y * x_stride, id = route[y] under mode bit 1; mode bit 2
// sums all n_slots weighted by route[n_slots + k] into one row (the
// MoE down projection).
//
// With -DSWIGLU too (matvec_q4_k_glu_b) W is the routed gate and WU
// (binding 4) the up matrix of the same shape: each row gets both dot
// products, exactly as the plain kernel computes them, and writes
// silu(gate) * up -- the gate, up and silu_mul dispatches of an MoE
// expert in one, reading the activations once (split slots only).
// With -DSWIGLU alone (matvec_q4_k_glu; i#688) the same for one
// token's dense FFN: binding 3 is unused.
//
// With -DSEGMENTS (matvec_q4_k_seg) the rows are those of up to three
// same-width matrices read from their own buffers (W, W1 at binding
// 4, W2 at binding 5), as if stacked: rows [0, seg1) of W go to O at
// out_offset, the next seg2 - seg1 rows (W1) to O2 at off1, the rest
// (W2) to O2 at off2. The q, k and v projections in one dispatch,
// without a concatenated copy of the weights; w_off must be 0. The
// first two segments can be roped in the epilogue, as
// matvec_q8_0_seg does (i#688): segment k's rows are heads of hs_k
// rows whose rd_k rows from ro_k on rotate at pos (rd_k 0 = none),
// rope.comp's interleaved pairs; a pair is two rows of one workgroup
// (rows start at multiples of 8; the host keeps seg1, hs, ro and rd
// even).
//
// With -DPAIRS (BATCHED only; i#623) the slots are a short batch's
// (token, expert) pairs, as in matvec_q8_0.comp: ROUTE holds one row per
// token, r_stride apart, of kp expert ids then kp weights.
// matvec_q4_k_glu_p runs workgroup y = pair p on expert
// route[(p / kp) * r_stride + p % kp] with token p / kp's x row, writing
// row p; matvec_q4_k_p runs workgroup y = token t, summing its kp
// experts (x rows t * kp + j) weighted into output row t.

// With -DTYPE_Q3K (matvec_q3_k and its _b / _glu / _seg builds,
// i#173) the rows are Q3_K: 110-byte super-blocks -- hmask[32] |
// qs[64] | scales[12] | f16 d, value d * (scale - 32) * (2-bit quant -
// (high bit clear ? 4 : 0)), a 6-bit scale per 16 elements (cpu_ops
// dequant_block_q3_k). A lane takes half-blocks (128 elements): the
// half's 32 quant bytes and the block's 32 hmask bytes as words once,
// then the four 2-bit passes from registers, two values per f16
// unpack. Every other build option works as for Q4_K.

#define LANES 16u
#define ROWS 8u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
// The same weights as 16-byte quads, read when the slot's byte offset
// is a multiple of 16 (blocks are 144 bytes, so every block is then).
layout(std430, binding = 0) readonly buffer W4 { uvec4 w4[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
// The same activations as vec4s (one load for four weights) when the
// slot's base is 16-byte aligned. An element offset divisible by 4 is
// a 16-byte address only because VulkanContext binds every buffer at
// offset 0.
layout(std430, binding = 1) readonly buffer X4 { vec4 x4[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef BATCHED
layout(std430, binding = 3) readonly buffer R { uint route[]; };
#endif
#ifdef SWIGLU
layout(std430, binding = 4) readonly buffer WU { uint wu[]; };
layout(std430, binding = 4) readonly buffer WU4 { uvec4 wu4[]; };
#endif
#ifdef SEGMENTS
layout(std430, binding = 3) buffer O2 { float o2[]; };
layout(std430, binding = 4) readonly buffer W1 { uint w1[]; };
layout(std430, binding = 4) readonly buffer W14 { uvec4 w14[]; };
layout(std430, binding = 5) readonly buffer W2 { uint w2[]; };
layout(std430, binding = 5) readonly buffer W24 { uvec4 w24[]; };
// Per-pair rope frequency divisors (rope.comp's F).
layout(std430, binding = 6) readonly buffer F { float f[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
#ifdef BATCHED
    uint w_stride;  // per slot, bytes
    uint x_stride;
    uint out_stride;
    uint n_slots;
    uint mode;      // 1 = ids from route[], 2 = weighted slot sum
    uint row_stride;  // unused: K-quant rows are never column-split
#endif
#ifdef PAIRS
    uint r_stride;  // ROUTE words per token row
    uint kp;        // routed slots per token
#endif
#ifdef SEGMENTS
    uint seg1;  // first row of W1
    uint off1;
    uint seg2;  // first row of W2
    uint off2;
    uint hs0, ro0, rd0;  // segment 0 rope: head rows, offset, width
    uint hs1, ro1, rd1;  // segment 1 rope
    uint pos;
    float freq_base;
    float freq_scale;    // YARN: 1/scaling_factor; 1.0 = off
    float corr_lo;
    float corr_hi;
#endif
} pc;

#ifdef SEGMENTS
uint g_seg;  // this thread's matrix: 0 = W, 1 = W1, 2 = W2
#endif

shared float red[LANES * ROWS];
#ifdef SWIGLU
shared float red_u[LANES * ROWS];
#endif

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

/** Word i of the weights: W, or WU when `up` (always a constant at
 * the call site, so it folds away). */
uint wword(uint i, bool up) {
#ifdef SWIGLU
    return up ? wu[i] : w[i];
#elif defined(SEGMENTS)
    return g_seg == 0u ? w[i] : (g_seg == 1u ? w1[i] : w2[i]);
#else
    return w[i];
#endif
}

/** The 16 bytes at byte offset b, b % 16 == 0. */
uvec4 wquad(uint b, bool up) {
#ifdef SWIGLU
    return up ? wu4[b >> 4] : w4[b >> 4];
#elif defined(SEGMENTS)
    return g_seg == 0u ? w4[b >> 4]
                       : (g_seg == 1u ? w14[b >> 4] : w24[b >> 4]);
#else
    return w4[b >> 4];
#endif
}

/** The 4 bytes at byte offset b (any alignment). */
uint word_at(uint b, bool up) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? wword(i, up)
                    : (wword(i, up) >> sh) |
                          (wword(i + 1u, up) << (32u - sh));
}

float f16_at(uint i) {
    return unpackHalf2x16(byte_at(i) | (byte_at(i + 1u) << 8u)).x;
}

/** Byte k (0..11) of the 12 packed scale bytes held in s0, s1, s2. */
uint sbyte(uint s0, uint s1, uint s2, uint k) {
    uint wd = k < 4u ? s0 : (k < 8u ? s1 : s2);
    return (wd >> ((k & 3u) * 8u)) & 0xffu;
}

/**
 * ggml get_scale_min_k4 for sub-block j, from the 12 scale bytes read
 * as three words.
 */
void scale_min(uint j, uint s0, uint s1, uint s2, out float d,
               out float m) {
    if (j < 4u) {
        d = float(sbyte(s0, s1, s2, j) & 63u);
        m = float(sbyte(s0, s1, s2, j + 4u) & 63u);
    } else {
        uint hi = sbyte(s0, s1, s2, j + 4u);
        d = float((hi & 0xfu) | ((sbyte(s0, s1, s2, j - 4u) >> 6u) << 4u));
        m = float((hi >> 4u) | ((sbyte(s0, s1, s2, j) >> 6u) << 4u));
    }
}

/** sum(q * x) and sum(x) over 4 nibbles of v at shift sh. */
void nib4(uint v, uint sh, vec4 xv, inout float sq, inout float sx) {
    // Two nibbles at a time: each lands in the mantissa of an f16
    // 1024 + n (exact), so one unpack yields two values.
    vec2 n02 = unpackHalf2x16(((v >> sh) & 0x000f000fu) | 0x64006400u);
    vec2 n13 =
        unpackHalf2x16(((v >> (sh + 8u)) & 0x000f000fu) | 0x64006400u);
    vec4 qv = vec4(n02.x, n13.x, n02.y, n13.y) - 1024.0;
    sq += dot(qv, xv);
    sx += xv.x + xv.y + xv.z + xv.w;
}

/** Activations xk .. xk + 3, one vec4 load when xal. */
vec4 xload(uint xk, bool xal) {
    return xal ? x4[xk >> 2]
               : vec4(x[xk], x[xk + 1u], x[xk + 2u], x[xk + 3u]);
}

#ifdef TYPE_Q3K
/** Byte i of the weights (W, or WU / W1 / W2 as wword picks). */
uint wbyte(uint i, bool up) {
    return (wword(i >> 2, up) >> ((i & 3u) * 8u)) & 0xffu;
}

/** Scale group g's 6-bit scale minus 32, from the 12 bytes s0 s1 s2. */
float q3_scale(uint s0, uint s1, uint s2, uint g) {
    uint i = g & 3u;
    uint grp = g >> 2;
    uint wd = (grp & 1u) == 0u ? s0 : s1;
    uint b = (wd >> (8u * i)) & 0xffu;
    uint lo = grp < 2u ? (b & 0xfu) : (b >> 4);
    uint hi = (s2 >> (8u * i + 2u * grp)) & 3u;
    return float(int(lo | (hi << 4)) - 32);
}

/**
 * sum(q * x) over the 4 elements of quant word qw and hmask word hw at
 * 2-bit field j, hmask bit hb: each value is (q >> 2j & 3) + 4 h - 4,
 * the bytes 0..7 decoded two at a time through an f16 mantissa.
 */
float q3w(uint qw, uint hw, uint j, uint hb, vec4 xv) {
    uint u = ((qw >> (2u * j)) & 0x03030303u) |
             (((hw >> hb) & 0x01010101u) << 2u);
    vec2 v02 = unpackHalf2x16((u & 0x00ff00ffu) | 0x64006400u);
    vec2 v13 = unpackHalf2x16(((u >> 8u) & 0x00ff00ffu) | 0x64006400u);
    vec4 qv = vec4(v02.x, v13.x, v02.y, v13.y) - 1028.0;
    return dot(qv, xv);
}

/** This lane's share of dot(row r of the Q3_K matrix at wbase, x). */
float row_part(uint wbase, uint xbase, uint r, uint lane, bool up) {
    uint nb = pc.cols / 256u;
    uint rb = wbase + r * nb * 110u;
    bool xal = (xbase & 3u) == 0u;
    float acc = 0.0;
    for (uint u = lane; u < nb * 2u; u += LANES) {
        uint b = u >> 1;
        uint n = u & 1u;  // half: elements 128n .. 128n + 127
        uint at = rb + b * 110u;
        uint qw[8], hw[8];
        for (uint k = 0u; k < 8u; ++k) {
            qw[k] = word_at(at + 32u + 32u * n + 4u * k, up);
            hw[k] = word_at(at + 4u * k, up);
        }
        // The block's tail (scale bytes 8..11, d) byte by byte: a word
        // there could reach past the last block's end.
        uint s0 = word_at(at + 96u, up), s1 = word_at(at + 100u, up);
        uint s2 = wbyte(at + 104u, up) | (wbyte(at + 105u, up) << 8u) |
                  (wbyte(at + 106u, up) << 16u) |
                  (wbyte(at + 107u, up) << 24u);
        float d = unpackHalf2x16(wbyte(at + 108u, up) |
                                 (wbyte(at + 109u, up) << 8u)).x;
        uint xi = xbase + b * 256u + n * 128u;
        float s = 0.0;
        for (uint j = 0u; j < 4u; ++j) {
            uint hb = 4u * n + j;
            float g0 = 0.0, g1 = 0.0;
            for (uint k = 0u; k < 4u; ++k) {
                g0 += q3w(qw[k], hw[k], j, hb,
                          xload(xi + 32u * j + 4u * k, xal));
                g1 += q3w(qw[k + 4u], hw[k + 4u], j, hb,
                          xload(xi + 32u * j + 16u + 4u * k, xal));
            }
            uint g = 8u * n + 2u * j;
            s += q3_scale(s0, s1, s2, g) * g0 +
                 q3_scale(s0, s1, s2, g + 1u) * g1;
        }
        acc += d * s;
    }
    return acc;
}
#else
/**
 * This lane's share of dot(row r of the matrix at wbase, x): per
 * sub-block pair, the 16-byte header, 32 nibble bytes and 16 vec4
 * activation loads.
 */
float row_part(uint wbase, uint xbase, uint r, uint lane, bool up) {
    uint nb = pc.cols / 256u;
    uint rb = wbase + r * nb * 144u;
    bool xal = (xbase & 3u) == 0u;
    bool wal = (wbase & 15u) == 0u;
    float acc = 0.0;
    for (uint u = lane; u < nb * 4u; u += LANES) {
        uint b = u >> 2;
        uint j = u & 3u;
        uint at = rb + b * 144u;
        uint q = at + 16u + j * 32u;
        uvec4 hd, qa, qb;
        if (wal) {
            hd = wquad(at, up);
            qa = wquad(q, up);
            qb = wquad(q + 16u, up);
        } else {
            hd = uvec4(word_at(at, up), word_at(at + 4u, up),
                       word_at(at + 8u, up), word_at(at + 12u, up));
            qa = uvec4(word_at(q, up), word_at(q + 4u, up),
                       word_at(q + 8u, up), word_at(q + 12u, up));
            qb = uvec4(word_at(q + 16u, up), word_at(q + 20u, up),
                       word_at(q + 24u, up), word_at(q + 28u, up));
        }
        vec2 dm = unpackHalf2x16(hd.x);
        float sc0, mn0, sc1, mn1;
        scale_min(2u * j, hd.y, hd.z, hd.w, sc0, mn0);
        scale_min(2u * j + 1u, hd.y, hd.z, hd.w, sc1, mn1);
        uint xi = xbase + b * 256u + j * 64u;
        float sq0 = 0.0, sx0 = 0.0, sq1 = 0.0, sx1 = 0.0;
        for (uint k = 0u; k < 8u; ++k) {
            uint v = k < 4u ? qa[k] : qb[k - 4u];
            uint xk = xi + k * 4u;
            nib4(v, 0u, xload(xk, xal), sq0, sx0);
            nib4(v, 4u, xload(xk + 32u, xal), sq1, sx1);
        }
        acc += dm.x * sc0 * sq0 - dm.y * mn0 * sx0;
        acc += dm.x * sc1 * sq1 - dm.y * mn1 * sx1;
    }
    return acc;
}

#endif

#ifdef SEGMENTS
/**
 * rope.comp's rotation of the pair (x0, x1) at pair offset i of an
 * rd-wide rope span: the even element's result, or the odd one's (as
 * matvec_q8_0.comp's).
 */
float rope_rot(float x0, float x1, uint i, uint rd, bool odd) {
    float theta_extrap =
        float(pc.pos) * pow(pc.freq_base, -float(i) / float(rd));
    float theta = theta_extrap;
    if (pc.freq_scale != 1.0) {
        float y = (float(i / 2u) - pc.corr_lo) /
                  max(0.001, pc.corr_hi - pc.corr_lo);
        float ramp = 1.0 - min(1.0, max(0.0, y));
        theta = pc.freq_scale * theta_extrap * (1.0 - ramp) +
                theta_extrap * ramp;
    }
    theta /= f[i / 2u];
    float c = cos(theta);
    float s = sin(theta);
    return odd ? x0 * s + x1 * c : x0 * c - x1 * s;
}
#endif

void main() {
    uint lane = gl_LocalInvocationID.x % LANES;
    uint slot = gl_LocalInvocationID.x / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint at = pc.out_offset + r;
    float acc = 0.0;
#ifdef SWIGLU
    float acc_u = 0.0;
#endif
    if (r < pc.rows) {
#if defined(PAIRS) && defined(SWIGLU)
        uint y = gl_WorkGroupID.y;
        uint tk = y / pc.kp;
        uint id = route[tk * pc.r_stride + y % pc.kp];
        uint wb = pc.w_off + id * pc.w_stride;
        uint xb = pc.x_off + tk * pc.x_stride;
        acc = row_part(wb, xb, r, lane, false);
        acc_u = row_part(wb, xb, r, lane, true);
        at += y * pc.out_stride;
#elif defined(PAIRS)
        uint y = gl_WorkGroupID.y;
        uint rb = y * pc.r_stride;
        for (uint k = 0u; k < pc.kp; ++k) {
            acc += uintBitsToFloat(route[rb + pc.kp + k]) *
                   row_part(pc.w_off + route[rb + k] * pc.w_stride,
                            pc.x_off + (y * pc.kp + k) * pc.x_stride, r,
                            lane, false);
        }
        at += y * pc.out_stride;
#elif defined(BATCHED)
        uint y = gl_WorkGroupID.y;
        bool sum = (pc.mode & 2u) != 0u;
        uint k1 = sum ? pc.n_slots : y + 1u;
        for (uint k = sum ? 0u : y; k < k1; ++k) {
            uint id = (pc.mode & 1u) != 0u ? route[k] : k;
            float wk = sum ? uintBitsToFloat(route[pc.n_slots + k])
                           : 1.0;
            uint wb = pc.w_off + id * pc.w_stride;
            uint xb = pc.x_off + k * pc.x_stride;
            acc += wk * row_part(wb, xb, r, lane, false);
#ifdef SWIGLU
            acc_u += wk * row_part(wb, xb, r, lane, true);
#endif
        }
        if (!sum) {
            at += y * pc.out_stride;
        }
#elif defined(SEGMENTS)
        g_seg = r >= pc.seg2 ? 2u : (r >= pc.seg1 ? 1u : 0u);
        uint lr = r - (g_seg == 2u ? pc.seg2 : (g_seg == 1u ? pc.seg1 : 0u));
        acc = row_part(0u, pc.x_off, lr, lane, false);
        at = g_seg == 2u ? pc.off2 + lr
           : (g_seg == 1u ? pc.off1 + lr : pc.out_offset + lr);
#else
        acc = row_part(pc.w_off, pc.x_off, r, lane, false);
#ifdef SWIGLU
        acc_u = row_part(pc.w_off, pc.x_off, r, lane, true);
#endif
#endif
    }
    red[gl_LocalInvocationID.x] = acc;
#ifdef SWIGLU
    red_u[gl_LocalInvocationID.x] = acc_u;
#endif
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            red[gl_LocalInvocationID.x] +=
                red[gl_LocalInvocationID.x + step];
#ifdef SWIGLU
            red_u[gl_LocalInvocationID.x] +=
                red_u[gl_LocalInvocationID.x + step];
#endif
        }
        barrier();
    }
    if (lane == 0u && r < pc.rows) {
        float v = red[gl_LocalInvocationID.x] * pc.scale;
#ifdef SWIGLU
        // silu_mul.comp's formula on the gate and up outputs.
        float u = red_u[gl_LocalInvocationID.x] * pc.scale;
        o[at] = v / (1.0 + exp(-v)) * u;
#elif defined(SEGMENTS)
        // Rope the finished dot (segments 0 and 1) with its pair's
        // partner row, the lane-0 sum of the neighbouring slot.
        bool s0 = g_seg == 0u;
        uint j = s0 ? r : r - pc.seg1;  // row within segment 0 / 1
        uint hs = s0 ? pc.hs0 : pc.hs1;
        uint ro = s0 ? pc.ro0 : pc.ro1;
        uint rd = s0 ? pc.rd0 : pc.rd1;
        uint wi = rd != 0u && g_seg < 2u ? j % hs : 0u;
        if (rd != 0u && g_seg < 2u && wi >= ro && wi < ro + rd) {
            uint k = wi - ro;
            bool odd = (k & 1u) != 0u;
            float vp = red[(slot ^ 1u) * LANES] * pc.scale;
            v = rope_rot(odd ? vp : v, odd ? v : vp, k & ~1u, rd, odd);
        }
        if (g_seg == 0u) {
            o[at] = v;
        } else {
            o2[at] = v;
        }
#else
        o[at] = pc.accumulate != 0 ? o[at] + v : v;
#endif
    }
}
