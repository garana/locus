#version 450

// Q4_K matvec: 144-byte super-blocks of 256 elements -- f16 d and
// dmin, 12 packed 6-bit scale/min pairs, 128 nibble bytes. Sub-block
// s = 2j + h (h = 0 low nibbles, 1 high) of super-block b covers the
// 32 elements 64j + 32h .. of the block, from bytes 32j .. 32j + 31.
//
// Eight rows per workgroup, 16 lanes per row: lanes stride over the
// row's 32-element sub-blocks (word loads of their 32 nibble bytes,
// decoded two at a time through an f16 mantissa; vec4 activation
// loads), each adding d*sc*sum(q*x) - dmin*m*sum(x), and a
// shared-memory tree reduces the row.
//
// Compiled again with -DBATCHED (matvec_q4_k_b): slots as in
// matvec_q8_0.comp -- slot y reads w_off + id * w_stride (bytes) and
// x_off + y * x_stride, id = route[y] under mode bit 1; mode bit 2
// sums all n_slots weighted by route[n_slots + k] into one row (the
// MoE down projection).
//
// With -DSWIGLU too (matvec_q4_k_glu_b) W is the routed gate and WU
// (binding 4) the up matrix of the same shape: each row gets both dot
// products, exactly as the plain kernel computes them, and writes
// silu(gate) * up -- the gate, up and silu_mul dispatches of an MoE
// expert in one, reading the activations once (split slots only).

#define LANES 16u
#define ROWS 8u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
// The same activations as vec4s (one load for four weights) when the
// slot's base is 16-byte aligned. An element offset divisible by 4 is
// a 16-byte address only because VulkanContext binds every buffer at
// offset 0.
layout(std430, binding = 1) readonly buffer X4 { vec4 x4[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef BATCHED
layout(std430, binding = 3) readonly buffer R { uint route[]; };
#endif
#ifdef SWIGLU
layout(std430, binding = 4) readonly buffer WU { uint wu[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
#ifdef BATCHED
    uint w_stride;  // per slot, bytes
    uint x_stride;
    uint out_stride;
    uint n_slots;
    uint mode;      // 1 = ids from route[], 2 = weighted slot sum
    uint row_stride;  // unused: K-quant rows are never column-split
#endif
} pc;

shared float red[LANES * ROWS];
#ifdef SWIGLU
shared float red_u[LANES * ROWS];
#endif

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

/** Word i of the weights: W, or WU when `up` (always a constant at
 * the call site, so it folds away). */
uint wword(uint i, bool up) {
#ifdef SWIGLU
    return up ? wu[i] : w[i];
#else
    return w[i];
#endif
}

/** The 4 bytes at byte offset b (any alignment). */
uint word_at(uint b, bool up) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? wword(i, up)
                    : (wword(i, up) >> sh) |
                          (wword(i + 1u, up) << (32u - sh));
}

float f16_at(uint i) {
    return unpackHalf2x16(byte_at(i) | (byte_at(i + 1u) << 8u)).x;
}

/** Byte k (0..11) of the 12 packed scale bytes held in s0, s1, s2. */
uint sbyte(uint s0, uint s1, uint s2, uint k) {
    uint wd = k < 4u ? s0 : (k < 8u ? s1 : s2);
    return (wd >> ((k & 3u) * 8u)) & 0xffu;
}

/**
 * ggml get_scale_min_k4 for sub-block j, from the 12 scale bytes read
 * as three words.
 */
void scale_min(uint j, uint s0, uint s1, uint s2, out float d,
               out float m) {
    if (j < 4u) {
        d = float(sbyte(s0, s1, s2, j) & 63u);
        m = float(sbyte(s0, s1, s2, j + 4u) & 63u);
    } else {
        uint hi = sbyte(s0, s1, s2, j + 4u);
        d = float((hi & 0xfu) | ((sbyte(s0, s1, s2, j - 4u) >> 6u) << 4u));
        m = float((hi >> 4u) | ((sbyte(s0, s1, s2, j) >> 6u) << 4u));
    }
}

/**
 * This lane's share of dot(row r of the matrix at wbase, x): per
 * 32-element sub-block, one word for d / dmin, three for the scales,
 * eight for the nibbles, and eight vec4 activation loads.
 */
float row_part(uint wbase, uint xbase, uint r, uint lane, bool up) {
    uint nb = pc.cols / 256u;
    uint rb = wbase + r * nb * 144u;
    bool xal = (xbase & 3u) == 0u;
    float acc = 0.0;
    for (uint u = lane; u < nb * 8u; u += LANES) {
        uint b = u >> 3;
        uint s = u & 7u;          // sub-block 2j + h
        uint j = s >> 1;
        uint sh = (s & 1u) * 4u;  // nibble shift
        uint at = rb + b * 144u;
        vec2 dm = unpackHalf2x16(word_at(at, up));
        float sc, mn;
        scale_min(s, word_at(at + 4u, up), word_at(at + 8u, up),
                  word_at(at + 12u, up), sc, mn);
        uint q = at + 16u + j * 32u;
        uint xi = xbase + b * 256u + j * 64u + (s & 1u) * 32u;
        float sq = 0.0, sx = 0.0;
        for (uint k = 0u; k < 8u; ++k) {
            uint v = word_at(q + k * 4u, up) >> sh;
            uint xk = xi + k * 4u;
            vec4 xv = xal ? x4[xk >> 2]
                          : vec4(x[xk], x[xk + 1u], x[xk + 2u], x[xk + 3u]);
            // Two nibbles at a time: each lands in the mantissa of an
            // f16 1024 + n (exact), so one unpack yields two values.
            vec2 n02 = unpackHalf2x16((v & 0x000f000fu) | 0x64006400u);
            vec2 n13 =
                unpackHalf2x16(((v >> 8u) & 0x000f000fu) | 0x64006400u);
            vec4 qv = vec4(n02.x, n13.x, n02.y, n13.y) - 1024.0;
            sq += dot(qv, xv);
            sx += xv.x + xv.y + xv.z + xv.w;
        }
        acc += dm.x * sc * sq - dm.y * mn * sx;
    }
    return acc;
}

void main() {
    uint lane = gl_LocalInvocationID.x % LANES;
    uint slot = gl_LocalInvocationID.x / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint at = pc.out_offset + r;
    float acc = 0.0;
#ifdef SWIGLU
    float acc_u = 0.0;
#endif
    if (r < pc.rows) {
#ifdef BATCHED
        uint y = gl_WorkGroupID.y;
        bool sum = (pc.mode & 2u) != 0u;
        uint k1 = sum ? pc.n_slots : y + 1u;
        for (uint k = sum ? 0u : y; k < k1; ++k) {
            uint id = (pc.mode & 1u) != 0u ? route[k] : k;
            float wk = sum ? uintBitsToFloat(route[pc.n_slots + k])
                           : 1.0;
            uint wb = pc.w_off + id * pc.w_stride;
            uint xb = pc.x_off + k * pc.x_stride;
            acc += wk * row_part(wb, xb, r, lane, false);
#ifdef SWIGLU
            acc_u += wk * row_part(wb, xb, r, lane, true);
#endif
        }
        if (!sum) {
            at += y * pc.out_stride;
        }
#else
        acc = row_part(pc.w_off, pc.x_off, r, lane, false);
#endif
    }
    red[gl_LocalInvocationID.x] = acc;
#ifdef SWIGLU
    red_u[gl_LocalInvocationID.x] = acc_u;
#endif
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            red[gl_LocalInvocationID.x] +=
                red[gl_LocalInvocationID.x + step];
#ifdef SWIGLU
            red_u[gl_LocalInvocationID.x] +=
                red_u[gl_LocalInvocationID.x + step];
#endif
        }
        barrier();
    }
    if (lane == 0u && r < pc.rows) {
        float v = red[gl_LocalInvocationID.x] * pc.scale;
#ifdef SWIGLU
        // silu_mul.comp's formula on the gate and up outputs.
        float u = red_u[gl_LocalInvocationID.x] * pc.scale;
        o[at] = v / (1.0 + exp(-v)) * u;
#else
        o[at] = pc.accumulate != 0 ? o[at] + v : v;
#endif
    }
}
