#version 450

// Q6_K matvec: 210-byte super-blocks of 256 elements -- 128 low-
// nibble bytes ql, 64 high-2-bit bytes qh, 16 signed scales, f16 d at
// the end. Half n (128 elements) uses ql[64n..], qh[32n..] and
// scales[8n..]; for l < 32 its four values are
//   q1 = ql[l] & 15  | (qh[l] >> 0 & 3) << 4   element l
//   q2 = ql[l+32] & 15 | (qh[l] >> 2 & 3) << 4 element l + 32
//   q3 = ql[l] >> 4  | (qh[l] >> 4 & 3) << 4   element l + 64
//   q4 = ql[l+32] >> 4 | (qh[l] >> 6 & 3) << 4 element l + 96
// minus 32, scaled by d * scales[8n + l / 16 + 2t] (t = 0..3).
//
// Eight rows per workgroup, 16 lanes per row: lanes stride over the
// row's 16-element groups (one scale each), reading 16 ql and 16 qh
// bytes as words (super-blocks are not word aligned, so through a
// funnel-shift word read; vec4 activation loads), and a shared-memory
// tree reduces the row.
//
// Compiled again with -DBATCHED (matvec_q6_k_b): slots and modes as
// matvec_q4_k.comp / matvec_q8_0.comp.

#define LANES 16u
#define ROWS 8u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
// The same activations as vec4s (one load for four weights) when the
// slot's base is 16-byte aligned. An element offset divisible by 4 is
// a 16-byte address only because VulkanContext binds every buffer at
// offset 0.
layout(std430, binding = 1) readonly buffer X4 { vec4 x4[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef BATCHED
layout(std430, binding = 3) readonly buffer R { uint route[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
#ifdef BATCHED
    uint w_stride;  // per slot, bytes
    uint x_stride;
    uint out_stride;
    uint n_slots;
    uint mode;      // 1 = ids from route[], 2 = weighted slot sum
    uint row_stride;  // unused: K-quant rows are never column-split
#endif
} pc;

shared float red[LANES * ROWS];

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

/** The 4 bytes at byte offset b (any alignment). */
uint word_at(uint b) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? w[i] : (w[i] >> sh) | (w[i + 1u] << (32u - sh));
}

float f16_at(uint i) {
    return unpackHalf2x16(byte_at(i) | (byte_at(i + 1u) << 8u)).x;
}

/** This lane's share of dot(row r of the matrix at wbase, x). */
float row_part(uint wbase, uint xbase, uint r, uint lane) {
    uint nb = pc.cols / 256u;
    uint rb = wbase + r * nb * 210u;
    bool xal = (xbase & 3u) == 0u;
    float acc = 0.0;
    // Group g = 16 per super-block: n = g >> 3, t = (g >> 1) & 3
    // (which of q1..q4), h = g & 1 (l in [16h, 16h + 16)).
    for (uint u = lane; u < nb * 16u; u += LANES) {
        uint b = u >> 4;
        uint g = u & 15u;
        uint n = g >> 3;
        uint t = (g >> 1) & 3u;
        uint h = g & 1u;
        uint at = rb + b * 210u;
        float d = unpackHalf2x16(word_at(at + 208u)).x;
        float sc = float(bitfieldExtract(
            int(byte_at(at + 192u + n * 8u + h + 2u * t)), 0, 8));
        // q1 / q3 read ql[l], q2 / q4 ql[l + 32]; q3 / q4 the high
        // nibble; qh bits 2t.
        uint ql = at + n * 64u + (t & 1u) * 32u + h * 16u;
        uint qh = at + 128u + n * 32u + h * 16u;
        uint lsh = (t >> 1) * 4u;
        uint hsh = 2u * t;
        uint xi = xbase + b * 256u + n * 128u + t * 32u + h * 16u;
        float s = 0.0;
        // The 16 ql and 16 qh bytes as 4 words each; a block at a
        // 2-mod-4 offset (210-byte blocks) reads 5 words and shifts.
        uint lw[4], hw[4];
        uint lsft = (ql & 3u) * 8u, hsft = (qh & 3u) * 8u;
        if (lsft == 0u) {
            for (uint k = 0u; k < 4u; ++k) {
                lw[k] = w[(ql >> 2) + k];
                hw[k] = w[(qh >> 2) + k];
            }
        } else {
            uint l0 = w[ql >> 2], h0 = w[qh >> 2];
            for (uint k = 0u; k < 4u; ++k) {
                uint l1 = w[(ql >> 2) + k + 1u], h1 = w[(qh >> 2) + k + 1u];
                lw[k] = (l0 >> lsft) | (l1 << (32u - lsft));
                hw[k] = (h0 >> hsft) | (h1 << (32u - hsft));
                l0 = l1;
                h0 = h1;
            }
        }
        for (uint k = 0u; k < 4u; ++k) {
            uint lo = lw[k] >> lsh;
            uint hi = hw[k] >> hsh;
            uint xk = xi + k * 4u;
            vec4 xv = xal ? x4[xk >> 2]
                          : vec4(x[xk], x[xk + 1u], x[xk + 2u], x[xk + 3u]);
            // Four 6-bit quants (low nibble | 2 high bits), minus 32.
            // Two at a time land in the mantissa of an f16 1024 + q
            // (exact), so one unpack yields two values.
            uint q4 = (lo & 0x0f0f0f0fu) | ((hi & 0x03030303u) << 4u);
            vec2 q02 = unpackHalf2x16((q4 & 0x003f003fu) | 0x64006400u);
            vec2 q13 =
                unpackHalf2x16(((q4 >> 8u) & 0x003f003fu) | 0x64006400u);
            vec4 qv = vec4(q02.x, q13.x, q02.y, q13.y) - 1056.0;
            s += dot(qv, xv);
        }
        acc += d * sc * s;
    }
    return acc;
}

void main() {
    uint lane = gl_LocalInvocationID.x % LANES;
    uint slot = gl_LocalInvocationID.x / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint at = pc.out_offset + r;
    float acc = 0.0;
    if (r < pc.rows) {
#ifdef BATCHED
        uint y = gl_WorkGroupID.y;
        bool sum = (pc.mode & 2u) != 0u;
        uint k1 = sum ? pc.n_slots : y + 1u;
        for (uint k = sum ? 0u : y; k < k1; ++k) {
            uint id = (pc.mode & 1u) != 0u ? route[k] : k;
            float wk = sum ? uintBitsToFloat(route[pc.n_slots + k])
                           : 1.0;
            acc += wk * row_part(pc.w_off + id * pc.w_stride,
                                 pc.x_off + k * pc.x_stride, r, lane);
        }
        if (!sum) {
            at += y * pc.out_stride;
        }
#else
        acc = row_part(pc.w_off, pc.x_off, r, lane);
#endif
    }
    red[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            red[gl_LocalInvocationID.x] +=
                red[gl_LocalInvocationID.x + step];
        }
        barrier();
    }
    if (lane == 0u && r < pc.rows) {
        float v = red[gl_LocalInvocationID.x] * pc.scale;
        o[at] = pc.accumulate != 0 ? o[at] + v : v;
    }
}
