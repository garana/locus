#version 450

// Q8_0 matvec: rows of 34-byte blocks (f16 scale + 32 int8), read
// through a uint view since blocks are not 4-byte aligned.

layout(local_size_x = 64) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer O { float o[]; };

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
} pc;

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

void main() {
    uint r = gl_GlobalInvocationID.x;
    if (r >= pc.rows) {
        return;
    }
    uint nb = pc.cols / 32u;
    uint row_base = pc.w_off + r * nb * 34u;
    float acc = 0.0;
    for (uint b = 0; b < nb; ++b) {
        uint at = row_base + b * 34u;
        float d = unpackHalf2x16(byte_at(at) |
                                 (byte_at(at + 1u) << 8u)).x;
        float s = 0.0;
        for (uint i = 0; i < 32u; ++i) {
            int q = bitfieldExtract(
                int(byte_at(at + 2u + i)), 0, 8);
            s += float(q) * x[pc.x_off + b * 32u + i];
        }
        acc += d * s;
    }
    uint at_out = pc.out_offset + r;
    float v = acc * pc.scale;
    o[at_out] = pc.accumulate != 0 ? o[at_out] + v : v;
}
