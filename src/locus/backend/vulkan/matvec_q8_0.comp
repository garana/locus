#version 450

// Q8_0 matvec over rows in the split GPU layout (q8_layout.hpp:
// nb f16 scales, then nb x 32 int8), read through a uint view.
//
// Four rows per workgroup, 32 lanes per row. Four lanes share a
// block, each taking two of its 8 quant words, so a 32-lane step
// reads 8 consecutive blocks (272 contiguous bytes, coalesced); a
// shared-memory tree then reduces the row.
//
// Compiled a second time with -DBATCHED (the *_b kernels): one
// dispatch covers several same-shape matrices. Slot y =
// gl_WorkGroupID.y reads w_off + id * w_stride, x_off + y * x_stride
// and writes out_offset + y * out_stride, where id = route[y] under
// mode bit 1 (MoE expert ids picked on the GPU), else y. Mode bit 2
// instead loops all n_slots inside each workgroup and sums them, each
// weighted by route[n_slots + k] (float bits), into one output row:
// the MoE down projection, without racing slots on one row.
//
// With -DSWIGLU (matvec_q8_0_glu, and _glu_b with BATCHED) W is the
// gate matrix and WU (last binding) the up matrix of the same shape:
// each row gets both dot products, computed exactly as the plain
// kernel would, and writes silu(gate) * up -- the gate, up and
// silu_mul dispatches of a SwiGLU block in one (split slots only).
//
// With -DSHARED (BATCHED only) the MoE's shared experts ride along
// with the routed ones. matvec_q8_0_sh_b, the down projection in
// weighted-sum mode, adds the shared expert's row (sh_cols wide, WS,
// reading x at sh_x_off) to each output. matvec_q8_0_glu_sh_b runs
// extra slots y >= n_slots on the shared gate / up matrices (WSG /
// WSU, sh_stride bytes per slot), writing at y * out_stride like the
// routed ones.
//
// With -DSEGMENTS (matvec_q8_0_seg) W is several matrices of the same
// width stacked by rows (e.g. wq | wk | wv) and the output rows go to
// up to three places: rows [0, seg1) to O at out_offset, [seg1, seg2)
// to O2 at off1, [seg2, rows) to O2 at off2 -- the projections that
// read one input, in one dispatch.
// With -DPAIRS (BATCHED only) the slots are a short batch's (token,
// expert) pairs, routed per token: ROUTE holds one row per token,
// r_stride apart, of kp expert ids then kp weights (moe_route_b's
// layout). matvec_q8_0_glu_p runs workgroup y = pair p on expert
// route[(p / kp) * r_stride + p % kp] with token p / kp's x row,
// writing row p. matvec_q8_0_p runs workgroup y = token t, summing
// its kp experts (x rows t * kp + j) weighted into output row t: a
// few tokens' routed MoE without grouping pairs by expert.

#define LANES 32u
#define ROWS 4u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef BATCHED
layout(std430, binding = 3) readonly buffer R { uint route[]; };
#endif
#ifdef SEGMENTS
layout(std430, binding = 3) buffer O2 { float o2[]; };
#endif
#ifdef SHARED
#ifdef SWIGLU
layout(std430, binding = 5) readonly buffer WSG { uint wsg[]; };
layout(std430, binding = 6) readonly buffer WSU { uint wsu[]; };
#else
layout(std430, binding = 4) readonly buffer WS { uint ws[]; };
#endif
#endif
#ifdef SWIGLU
#ifdef BATCHED
layout(std430, binding = 4) readonly buffer WU { uint wu[]; };
#else
layout(std430, binding = 3) readonly buffer WU { uint wu[]; };
#endif
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;   // element offset (f32/f16), byte offset (quant)
    uint x_off;
    float scale;
#ifdef BATCHED
    uint w_stride;  // per slot, in w_off units
    uint x_stride;
    uint out_stride;
    uint n_slots;
    uint mode;      // 1 = ids from route[], 2 = weighted slot sum
    uint row_stride;  // unused: Q8_0 rows are never column-split
#endif
#ifdef SHARED
#ifdef SWIGLU
    uint sh_stride;  // bytes between shared slots in WSG / WSU
    uint sh_unused;
#else
    uint sh_cols;    // shared down row width
    uint sh_x_off;
#endif
#endif
#ifdef SEGMENTS
    uint seg1;  // first row written to O2 at off1
    uint off1;
    uint seg2;  // first row written to O2 at off2
    uint off2;
#endif
#ifdef PAIRS
    uint r_stride;  // ROUTE words per token row
    uint kp;        // routed slots per token
#endif
} pc;

shared float red[LANES * ROWS];
#ifdef SWIGLU
shared float red_u[LANES * ROWS];
#endif

/** The 4 bytes at byte offset b (any alignment) of BUF. */
#define DEFINE_WORD_AT(NAME, BUF) \
uint NAME(uint b) { \
    uint i = b >> 2; \
    uint sh = (b & 3u) * 8u; \
    return sh == 0u ? BUF[i] \
                    : (BUF[i] >> sh) | (BUF[i + 1u] << (32u - sh)); \
}

/**
 * This lane's share of dot(row r of the matrix at wbase, x), nb
 * blocks wide. Rows are in the split GPU layout (q8_layout.hpp): nb
 * f16 scales, then nb x 32 quants, 34 * nb bytes in all.
 */
#define DEFINE_ROW_PART(NAME, WORD, BUF) \
float NAME(uint wbase, uint xbase, uint r, uint lane, uint nb) { \
    uint rb = wbase + r * nb * 34u; \
    uint qb = rb + 2u * nb; \
    uint sub = lane & 3u; \
    /* Whole-word quant loads unless the row start is misaligned \
       (odd nb, or an odd w_off); scales are 2-byte aligned. */ \
    bool al = ((rb | qb) & 3u) == 0u; \
    float acc = 0.0; \
    for (uint b = lane >> 2; b < nb; b += LANES / 4u) { \
        uint sa = rb + 2u * b; \
        float d = unpackHalf2x16(BUF[sa >> 2] >> ((sa & 2u) * 8u)).x; \
        uint qa = qb + b * 32u + sub * 8u; \
        uint xi = xbase + b * 32u + sub * 8u; \
        float s = 0.0; \
        for (uint k = 0u; k < 2u; ++k) { \
            int q = int(al ? BUF[(qa >> 2) + k] : WORD(qa + k * 4u)); \
            uint xk = xi + k * 4u; \
            s += float(bitfieldExtract(q, 0, 8)) * x[xk] + \
                 float(bitfieldExtract(q, 8, 8)) * x[xk + 1u] + \
                 float(bitfieldExtract(q, 16, 8)) * x[xk + 2u] + \
                 float(bitfieldExtract(q, 24, 8)) * x[xk + 3u]; \
        } \
        acc += d * s; \
    } \
    return acc; \
}

DEFINE_WORD_AT(word_at, w)
DEFINE_ROW_PART(row_part, word_at, w)
#ifdef SWIGLU
DEFINE_WORD_AT(word_at_u, wu)
DEFINE_ROW_PART(row_part_u, word_at_u, wu)
#endif
#ifdef SHARED
#ifdef SWIGLU
DEFINE_WORD_AT(word_at_sg, wsg)
DEFINE_ROW_PART(row_part_sg, word_at_sg, wsg)
DEFINE_WORD_AT(word_at_su, wsu)
DEFINE_ROW_PART(row_part_su, word_at_su, wsu)
#else
DEFINE_WORD_AT(word_at_s, ws)
DEFINE_ROW_PART(row_part_s, word_at_s, ws)
#endif
#endif

void main() {
    uint lane = gl_LocalInvocationID.x % LANES;
    uint slot = gl_LocalInvocationID.x / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint at = pc.out_offset + r;
    uint nb = pc.cols / 32u;
    float acc = 0.0;
#ifdef SWIGLU
    float acc_u = 0.0;
    if (r < pc.rows) {
#if defined(PAIRS)
        uint y = gl_WorkGroupID.y;
        uint tk = y / pc.kp;
        uint id = route[tk * pc.r_stride + y % pc.kp];
        uint wb = pc.w_off + id * pc.w_stride;
        uint xb = pc.x_off + tk * pc.x_stride;
        at += y * pc.out_stride;
#elif defined(BATCHED)
        uint y = gl_WorkGroupID.y;
        uint id = (pc.mode & 1u) != 0u && y < pc.n_slots ? route[y] : y;
        uint wb = pc.w_off + id * pc.w_stride;
        uint xb = pc.x_off + y * pc.x_stride;
        at += y * pc.out_stride;
#else
        uint wb = pc.w_off;
        uint xb = pc.x_off;
#endif
#ifdef SHARED
        if (gl_WorkGroupID.y >= pc.n_slots) {
            uint sb = (gl_WorkGroupID.y - pc.n_slots) * pc.sh_stride;
            acc = row_part_sg(sb, xb, r, lane, nb);
            acc_u = row_part_su(sb, xb, r, lane, nb);
        } else
#endif
        {
            acc = row_part(wb, xb, r, lane, nb);
            acc_u = row_part_u(wb, xb, r, lane, nb);
        }
    }
    red_u[gl_LocalInvocationID.x] = acc_u;
#else
    if (r < pc.rows) {
#if defined(PAIRS)
        uint y = gl_WorkGroupID.y;
        uint rb = y * pc.r_stride;
        for (uint k = 0u; k < pc.kp; ++k) {
            acc += uintBitsToFloat(route[rb + pc.kp + k]) *
                   row_part(pc.w_off + route[rb + k] * pc.w_stride,
                            pc.x_off + (y * pc.kp + k) * pc.x_stride, r,
                            lane, nb);
        }
        at += y * pc.out_stride;
#elif defined(BATCHED)
        uint y = gl_WorkGroupID.y;
        bool sum = (pc.mode & 2u) != 0u;
        uint k1 = sum ? pc.n_slots : y + 1u;
        for (uint k = sum ? 0u : y; k < k1; ++k) {
            uint id = (pc.mode & 1u) != 0u ? route[k] : k;
            float wk = sum ? uintBitsToFloat(route[pc.n_slots + k])
                           : 1.0;
            acc += wk * row_part(pc.w_off + id * pc.w_stride,
                                 pc.x_off + k * pc.x_stride, r, lane, nb);
        }
#ifdef SHARED
        acc += row_part_s(0u, pc.sh_x_off, r, lane, pc.sh_cols / 32u);
#endif
        if (!sum) {
            at += y * pc.out_stride;
        }
#else
        acc = row_part(pc.w_off, pc.x_off, r, lane, nb);
#endif
    }
#endif
    red[gl_LocalInvocationID.x] = acc;
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            red[gl_LocalInvocationID.x] +=
                red[gl_LocalInvocationID.x + step];
#ifdef SWIGLU
            red_u[gl_LocalInvocationID.x] +=
                red_u[gl_LocalInvocationID.x + step];
#endif
        }
        barrier();
    }
    if (lane == 0u && r < pc.rows) {
        float v = red[gl_LocalInvocationID.x] * pc.scale;
#ifdef SWIGLU
        // silu_mul.comp's formula on the gate and up outputs.
        float u = red_u[gl_LocalInvocationID.x] * pc.scale;
        o[at] = v / (1.0 + exp(-v)) * u;
#elif defined(SEGMENTS)
        if (r < pc.seg1) {
            o[at] = pc.accumulate != 0 ? o[at] + v : v;
        } else {
            uint oi = r < pc.seg2 ? pc.off1 + (r - pc.seg1)
                                  : pc.off2 + (r - pc.seg2);
            o2[oi] = pc.accumulate != 0 ? o2[oi] + v : v;
        }
#else
        o[at] = pc.accumulate != 0 ? o[at] + v : v;
#endif
    }
}
