#version 450

// Paged causal attention for one token, one layer, reading K/V
// straight from the paged pool through the sequence's block table
// (DESIGN.md 4.1/4.3). Two passes with an ATT scratch row per
// head: scores + max, then softmax-weighted V accumulation.
// One workgroup per query head (dispatch n_heads groups): threads
// split the positions for the scores and the softmax (max and sum
// reduced through shared memory), then (dim, position-slice) pairs
// for the weighted sum, whose slices are summed at the end.
//
// Compiled again with -DBATCHED (attn_paged_b): workgroup y is query token y
// of a prefill chunk, at position n_pos - 1 + y (so it attends over
// n_pos + y positions), with its Q/output rows at y * q_stride and
// its ATT rows at (y * n_heads + h) * att_stride.

#define WG 128u

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer Q { float q[]; };
layout(std430, binding = 1) readonly buffer POOL { float pool[]; };
layout(std430, binding = 2) readonly buffer TABLE { uint table[]; };
layout(std430, binding = 3) buffer ATT { float att[]; };
layout(std430, binding = 4) writeonly buffer O { float o[]; };

layout(push_constant) uniform PC {
    uint n_heads;
    uint group;         // n_heads / n_kv_heads
    uint head_dim;
    uint kv_dim;        // n_kv_heads * head_dim
    uint n_pos;         // positions to attend over (pos + 1)
    uint block_tokens;
    uint block_stride;  // floats per block
    uint layer_offset;  // floats: layer * layer_stride
    uint v_offset;      // floats: K row -> V row delta
#ifdef BATCHED
    uint q_stride;      // floats between token rows of Q and O
    uint att_stride;    // floats per ATT row (>= last n_pos)
#endif
} pc;

shared float red[WG];
// P * head width; ATTN_PART_MAX is vk::kAttnPartMax (limits.hpp),
// passed by CMake; the host rejects wider heads.
shared float part[ATTN_PART_MAX];

float reduce_max(float v) {
    uint tid = gl_LocalInvocationID.x;
    red[tid] = v;
    barrier();
    for (uint step = WG / 2u; step > 0u; step >>= 1) {
        if (tid < step) {
            red[tid] = max(red[tid], red[tid + step]);
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

float reduce_sum(float v) {
    uint tid = gl_LocalInvocationID.x;
    red[tid] = v;
    barrier();
    for (uint step = WG / 2u; step > 0u; step >>= 1) {
        if (tid < step) {
            red[tid] += red[tid + step];
        }
        barrier();
    }
    float r = red[0];
    barrier();
    return r;
}

uint kv_base(uint t) {
    uint blk = table[t / pc.block_tokens];
    return blk * pc.block_stride + pc.layer_offset +
           (t % pc.block_tokens) * pc.kv_dim;
}

void main() {
    uint h = gl_WorkGroupID.x;
    uint tid = gl_LocalInvocationID.x;
    if (h >= pc.n_heads) {
        return;
    }
    uint qh = h * pc.head_dim;
    uint kvh = (h / pc.group) * pc.head_dim;
#ifdef BATCHED
    uint y = gl_WorkGroupID.y;
    uint n_pos = pc.n_pos + y;
    qh += y * pc.q_stride;
    uint arow = (y * pc.n_heads + h) * pc.att_stride;
#else
    uint n_pos = pc.n_pos;
    uint arow = h * pc.n_pos;
#endif
    float scale = inversesqrt(float(pc.head_dim));

    float mx = -3.4e38;
    for (uint t = tid; t < n_pos; t += WG) {
        uint kb = kv_base(t) + kvh;
        float s = 0.0;
        for (uint i = 0; i < pc.head_dim; ++i) {
            s += q[qh + i] * pool[kb + i];
        }
        s *= scale;
        att[arow + t] = s;
        mx = max(mx, s);
    }
    mx = reduce_max(mx);
    float sum = 0.0;
    for (uint t = tid; t < n_pos; t += WG) {
        float e = exp(att[arow + t] - mx);
        att[arow + t] = e;
        sum += e;
    }
    memoryBarrierBuffer();
    sum = reduce_sum(sum);

    uint np = max(1u, WG / pc.head_dim);
    for (uint idx = tid; idx < pc.head_dim * np; idx += WG) {
        uint i = idx % pc.head_dim;
        float acc = 0.0;
        for (uint t = idx / pc.head_dim; t < n_pos; t += np) {
            acc += att[arow + t] *
                   pool[kv_base(t) + pc.v_offset + kvh + i];
        }
        part[idx] = acc;
    }
    barrier();
    for (uint i = tid; i < pc.head_dim; i += WG) {
        float acc = 0.0;
        for (uint p = 0; p < np; ++p) {
            acc += part[p * pc.head_dim + i];
        }
        o[qh + i] = acc / sum;
    }
}
