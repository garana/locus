#version 450

// MoE expert selection on the GPU, mirroring model::moe_select so a
// MoE layer needs no host round-trip: gating (softmax or sigmoid)
// over the router logits, optional selection bias (V3/K2),
// group-limited routing (each group scored by its top-2), top-k
// with lowest-index tie-break, then optional weight normalization
// and scaling.
//
// One 256-thread workgroup, every score in shared memory (n_expert
// <= 256). L holds n_splits planes of n_expert partial logits
// (split-K router matvec), summed in plane order. Softmax sums its
// exps on thread 0 in expert order, as on the CPU; top-k is one
// parallel
// pass: an expert's rank is the number of experts that beat it
// (higher score, or equal and lower index), and rank j < k fills
// route slot j. ROUTE receives ids[k] then the k weights as float
// bits -- the layout the batched matvec kernels read.
//
// Compiled again with -DBATCHED (moe_route_b): workgroup y routes
// token y of a prefill chunk, its L rows at y * l_stride and its
// route at y * r_stride.

layout(local_size_x = 256) in;

layout(std430, binding = 0) readonly buffer L { float l[]; };
layout(std430, binding = 1) readonly buffer B { float bias[]; };
layout(std430, binding = 2) writeonly buffer R { uint route[]; };

layout(push_constant) uniform PC {
    uint n_expert;      // <= 256
    uint k;             // <= 16
    uint sigmoid;       // 0 = softmax gating, 1 = sigmoid
    uint has_bias;
    uint n_group;       // <= 32; 0 or 1 = no group limit
    uint n_group_used;
    uint norm;          // normalize picked weights to sum 1
    float scale;
    uint n_splits;      // partial-logit planes in L (>= 1)
#ifdef BATCHED
    uint l_stride;
    uint r_stride;
#endif
} pc;

#define WG 256u
#define MAX_K 16u

shared float prob[WG];
shared float sel[WG];
shared uint picked[MAX_K];

void main() {
    uint t = gl_LocalInvocationID.x;
#ifdef BATCHED
    uint lb = gl_WorkGroupID.y * pc.l_stride;
    uint rb = gl_WorkGroupID.y * pc.r_stride;
#else
    uint lb = 0u;
    uint rb = 0u;
#endif
    uint n = pc.n_expert;
    if (t < n) {
        float v = 0.0;
        for (uint sp = 0u; sp < pc.n_splits; ++sp) {
            v += l[lb + sp * n + t];
        }
        prob[t] = pc.sigmoid != 0u ? 1.0 / (1.0 + exp(-v)) : v;
    }
    barrier();
    if (pc.sigmoid == 0u) {
        // Softmax: max and exps in parallel; the sum stays serial in
        // expert order (the CPU's), broadcast through sel[0].
        float mx = prob[0];
        for (uint e = 1u; e < n; ++e) {
            mx = max(mx, prob[e]);
        }
        float ex = t < n ? exp(prob[t] - mx) : 0.0;
        barrier();
        if (t < n) {
            prob[t] = ex;
        }
        barrier();
        if (t == 0u) {
            float sum = 0.0;
            for (uint e = 0u; e < n; ++e) {
                sum += prob[e];
            }
            sel[0] = sum;
        }
        barrier();
        float sum = sel[0];
        barrier();
        if (t < n) {
            prob[t] = ex / sum;
        }
    }
    barrier();
    if (t < n) {
        sel[t] = prob[t] + (pc.has_bias != 0u ? bias[t] : 0.0);
    }
    barrier();
    if (pc.n_group > 1u && t == 0u) {
        uint per = n / pc.n_group;
        uint keep = 0u;
        for (uint g = 0u; g < pc.n_group_used; ++g) {
            uint best = pc.n_group;
            float best_s = 0.0;
            for (uint gi = 0u; gi < pc.n_group; ++gi) {
                if ((keep & (1u << gi)) != 0u) {
                    continue;
                }
                float top1 = -1e30, top2 = -1e30;
                for (uint e = gi * per; e < (gi + 1u) * per; ++e) {
                    float sv = sel[e];
                    if (sv > top1) {
                        top2 = top1;
                        top1 = sv;
                    } else if (sv > top2) {
                        top2 = sv;
                    }
                }
                float gs = top1 + (per > 1u ? top2 : 0.0);
                if (best == pc.n_group || gs > best_s) {
                    best = gi;
                    best_s = gs;
                }
            }
            keep |= 1u << best;
        }
        for (uint e = 0u; e < n; ++e) {
            if ((keep & (1u << (e / per))) == 0u) {
                sel[e] = -1e30;
            }
        }
    }
    barrier();
    if (t < n) {
        float sv = sel[t];
        uint rank = 0u;
        for (uint f = 0u; f < n; ++f) {
            float sf = sel[f];
            rank += (sf > sv || (sf == sv && f < t)) ? 1u : 0u;
        }
        if (rank < pc.k) {
            picked[rank] = t;
        }
    }
    barrier();
    if (t == 0u) {
        float wsum = 0.0;
        for (uint j = 0u; j < pc.k; ++j) {
            wsum += prob[picked[j]];
        }
        if (pc.norm == 0u) {
            wsum = 1.0;
        }
        for (uint j = 0u; j < pc.k; ++j) {
            route[rb + j] = picked[j];
            route[rb + pc.k + j] =
                floatBitsToUint(prob[picked[j]] / wsum * pc.scale);
        }
    }
}
