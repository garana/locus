#version 450

// Interleaved-pair RoPE, one invocation per head, rotating in
// place at `offset + h*stride`. Supports llama frequency factors
// (divisors buffer) and YARN corrections (freq_scale != 1).
//
// Compiled again with -DBATCHED (rope_b): workgroup y rotates row y
// of a prefill chunk, at position pos + y and offset + y *
// row_stride.
//
// With -DNEOX (rope_neox, rope_neox_b) the pairs are NEOX-style,
// (x[j], x[j + head_dim / 2]) for j < head_dim / 2, with the same
// angle for pair j as the interleaved pair (2j, 2j + 1) above (Qwen2 /
// Qwen3; the CPU's rope_neox_yarn).

layout(local_size_x = 1) in;

layout(std430, binding = 0) buffer X { float x[]; };
// Per-pair frequency divisors (rope_freqs.weight for llama3
// scaling); a ones buffer when the model is unscaled.
layout(std430, binding = 1) readonly buffer F { float f[]; };

layout(push_constant) uniform PC {
    uint n_heads;
    uint head_dim;
    uint pos;
    uint offset;      // float offset of the first head
    uint stride;      // floats between consecutive heads
    float freq_base;
    float freq_scale; // YARN: 1/scaling_factor; 1.0 = off
    float corr_lo;    // YARN correction dims (precomputed)
    float corr_hi;
#ifdef BATCHED
    uint row_stride;  // floats between consecutive token rows
#endif
} pc;

void main() {
    uint h = gl_GlobalInvocationID.x;
    if (h >= pc.n_heads) {
        return;
    }
    uint base = pc.offset + h * pc.stride;
    uint pos = pc.pos;
#ifdef BATCHED
    base += gl_WorkGroupID.y * pc.row_stride;
    pos += gl_WorkGroupID.y;
#endif
    for (uint i = 0; i + 1u < pc.head_dim; i += 2u) {
        float theta_extrap =
            float(pos) *
            pow(pc.freq_base, -float(i) / float(pc.head_dim));
        float theta = theta_extrap;
        if (pc.freq_scale != 1.0) {
            float y = (float(i / 2u) - pc.corr_lo) /
                      max(0.001, pc.corr_hi - pc.corr_lo);
            float ramp = 1.0 - min(1.0, max(0.0, y));
            theta = pc.freq_scale * theta_extrap * (1.0 - ramp) +
                    theta_extrap * ramp;
        }
        theta /= f[i / 2u];
        float c = cos(theta);
        float s = sin(theta);
#ifdef NEOX
        uint a = base + i / 2u;
        uint b = a + pc.head_dim / 2u;
#else
        uint a = base + i;
        uint b = a + 1u;
#endif
        float x0 = x[a];
        float x1 = x[b];
        x[a] = x0 * c - x1 * s;
        x[b] = x0 * s + x1 * c;
    }
}
