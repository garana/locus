#version 450

// K-quant matvec over up to NT token rows at once (#436, a sibling of
// matvec_q8_0_n.comp): out[t][r] (+)= scale * dot(W row r, X row t)
// for t < n_tok, each weight block loaded once for all the tokens.
// Q4_K by default (matvec_q4_k_n), Q6_K with -DQ6K (matvec_q6_k_n);
// rows in the GGUF layout, as matvec_q4_k.comp / matvec_q6_k.comp.
//
// Eight rows per workgroup, 16 lanes per row, the lane split and the
// per-token arithmetic of the single-token kernels, so a token's
// result does not depend on how many tokens share the dispatch, nor
// on the build (NT 8, or NT 2 with -DNT2). Push constants and grid as
// matvec_q8_0_n.comp: X row t at x_off + t * x_stride, output row t
// at out_offset + t * out_stride, workgroup y a batch b shifting W, X
// and out by b * w_bstride (bytes), b * x_bstride and b * out_bstride.
//
// -DSWIGLU (matvec_q4_k_n_glu, Q4_K only): W is the gate matrix and WU
// (binding 3) the up matrix of the same shape; each output gets both
// dots, computed as the plain kernel computes one, and is
// silu(gate) * up: the gate, up and silu_mul dispatches in one.

#define LANES 16u
#define ROWS 8u
#ifdef NT2
#define NT 2u
#else
#define NT 8u
#endif

layout(local_size_x = 128) in;

layout(std430, binding = 0) readonly buffer W { uint w[]; };
layout(std430, binding = 0) readonly buffer W4 { uvec4 w4[]; };
layout(std430, binding = 1) readonly buffer X { float x[]; };
layout(std430, binding = 1) readonly buffer X4 { vec4 x4[]; };
layout(std430, binding = 2) buffer O { float o[]; };
#ifdef SWIGLU
layout(std430, binding = 3) readonly buffer WU { uint wu[]; };
layout(std430, binding = 3) readonly buffer WU4 { uvec4 wu4[]; };
#endif

layout(push_constant) uniform PC {
    uint rows;
    uint cols;
    uint out_offset;
    uint accumulate;
    uint w_off;         // bytes
    uint x_off;
    float scale;
    uint n_tok;         // <= NT
    uint x_stride;
    uint out_stride;
    uint w_bstride;
    uint x_bstride;
    uint out_bstride;
} pc;

shared float red[NT * LANES * ROWS];
#ifdef SWIGLU
shared float red_u[NT * LANES * ROWS];
#endif

uint byte_at(uint i) {
    return (w[i >> 2] >> ((i & 3u) * 8u)) & 0xffu;
}

/** Word i of W, or of WU when `up` (a constant at every call site). */
uint wword(uint i, bool up) {
#ifdef SWIGLU
    return up ? wu[i] : w[i];
#else
    return w[i];
#endif
}

/** The 16 bytes at byte offset b of W (or WU), b % 16 == 0. */
uvec4 wquad(uint b, bool up) {
#ifdef SWIGLU
    return up ? wu4[b >> 4] : w4[b >> 4];
#else
    return w4[b >> 4];
#endif
}

/** The 4 bytes at byte offset b (any alignment) of W, or WU. */
uint word_at(uint b, bool up) {
    uint i = b >> 2;
    uint sh = (b & 3u) * 8u;
    return sh == 0u ? wword(i, up)
                    : (wword(i, up) >> sh) |
                          (wword(i + 1u, up) << (32u - sh));
}
uint word_at(uint b) { return word_at(b, false); }

/** Activations xk .. xk + 3, one vec4 load when xal. */
vec4 xload(uint xk, bool xal) {
    return xal ? x4[xk >> 2]
               : vec4(x[xk], x[xk + 1u], x[xk + 2u], x[xk + 3u]);
}

#ifndef Q6K
/** Byte k (0..11) of the 12 packed scale bytes held in s0, s1, s2. */
uint sbyte(uint s0, uint s1, uint s2, uint k) {
    uint wd = k < 4u ? s0 : (k < 8u ? s1 : s2);
    return (wd >> ((k & 3u) * 8u)) & 0xffu;
}

/** ggml get_scale_min_k4 for sub-block j (matvec_q4_k.comp). */
void scale_min(uint j, uint s0, uint s1, uint s2, out float d,
               out float m) {
    if (j < 4u) {
        d = float(sbyte(s0, s1, s2, j) & 63u);
        m = float(sbyte(s0, s1, s2, j + 4u) & 63u);
    } else {
        uint hi = sbyte(s0, s1, s2, j + 4u);
        d = float((hi & 0xfu) | ((sbyte(s0, s1, s2, j - 4u) >> 6u) << 4u));
        m = float((hi >> 4u) | ((sbyte(s0, s1, s2, j) >> 6u) << 4u));
    }
}

/** sum(q * x) and sum(x) over 4 nibbles of v at shift sh. */
void nib4(uint v, uint sh, vec4 xv, inout float sq, inout float sx) {
    vec2 n02 = unpackHalf2x16(((v >> sh) & 0x000f000fu) | 0x64006400u);
    vec2 n13 =
        unpackHalf2x16(((v >> (sh + 8u)) & 0x000f000fu) | 0x64006400u);
    vec4 qv = vec4(n02.x, n13.x, n02.y, n13.y) - 1024.0;
    sq += dot(qv, xv);
    sx += xv.x + xv.y + xv.z + xv.w;
}

/** Super-block sub-pair u's header and nibbles: d / dmin, the two
 * sub-blocks' scales and mins, and 32 nibble bytes. */
struct Q4Blk {
    vec2 dm;
    float sc0, mn0, sc1, mn1;
    uvec4 qa, qb;
};

Q4Blk q4_load(uint rb, uint b, uint j, bool wal, bool up) {
    uint at = rb + b * 144u;
    uint q = at + 16u + j * 32u;
    uvec4 hd;
    Q4Blk k;
    if (wal) {
        hd = wquad(at, up);
        k.qa = wquad(q, up);
        k.qb = wquad(q + 16u, up);
    } else {
        hd = uvec4(word_at(at, up), word_at(at + 4u, up),
                   word_at(at + 8u, up), word_at(at + 12u, up));
        k.qa = uvec4(word_at(q, up), word_at(q + 4u, up),
                     word_at(q + 8u, up), word_at(q + 12u, up));
        k.qb = uvec4(word_at(q + 16u, up), word_at(q + 20u, up),
                     word_at(q + 24u, up), word_at(q + 28u, up));
    }
    k.dm = unpackHalf2x16(hd.x);
    scale_min(2u * j, hd.y, hd.z, hd.w, k.sc0, k.mn0);
    scale_min(2u * j + 1u, hd.y, hd.z, hd.w, k.sc1, k.mn1);
    return k;
}

/** Adds one token's share of sub-pair k against x at xt to acc, in
 * matvec_q4_k.comp's row_part order (one add per sub-block). */
void q4_dot(Q4Blk k, uint xt, bool xal, inout float acc) {
    float sq0 = 0.0, sx0 = 0.0, sq1 = 0.0, sx1 = 0.0;
    for (uint i = 0u; i < 8u; ++i) {
        uint v = i < 4u ? k.qa[i] : k.qb[i - 4u];
        uint xk = xt + i * 4u;
        nib4(v, 0u, xload(xk, xal), sq0, sx0);
        nib4(v, 4u, xload(xk + 32u, xal), sq1, sx1);
    }
    acc += k.dm.x * k.sc0 * sq0 - k.dm.y * k.mn0 * sx0;
    acc += k.dm.x * k.sc1 * sq1 - k.dm.y * k.mn1 * sx1;
}
#endif

void main() {
    uint tid = gl_LocalInvocationID.x;
    uint lane = tid % LANES;
    uint slot = tid / LANES;
    uint r = gl_WorkGroupID.x * ROWS + slot;
    uint nt = min(pc.n_tok, NT);
    uint bt = gl_WorkGroupID.y;
    uint xbase = pc.x_off + bt * pc.x_bstride;
    uint wbase = pc.w_off + bt * pc.w_bstride;
    bool xal = ((xbase | pc.x_stride) & 3u) == 0u;
    float acc[NT];
    for (uint t = 0u; t < NT; ++t) {
        acc[t] = 0.0;
    }
#ifdef SWIGLU
    float acc_u[NT];
    for (uint t = 0u; t < NT; ++t) {
        acc_u[t] = 0.0;
    }
#endif
    if (r < pc.rows) {
        uint nb = pc.cols / 256u;
#ifndef Q6K
        uint rb = wbase + r * nb * 144u;
        bool wal = (wbase & 15u) == 0u;
        for (uint u = lane; u < nb * 4u; u += LANES) {
            uint b = u >> 2;
            uint j = u & 3u;
            Q4Blk kg = q4_load(rb, b, j, wal, false);
#ifdef SWIGLU
            Q4Blk ku = q4_load(rb, b, j, wal, true);
#endif
            uint xi = xbase + b * 256u + j * 64u;
            // Constant trip count (guard inside) keeps acc in
            // registers.
            for (uint t = 0u; t < NT; ++t) {
                if (t < nt) {
                    uint xt = xi + t * pc.x_stride;
                    q4_dot(kg, xt, xal, acc[t]);
#ifdef SWIGLU
                    q4_dot(ku, xt, xal, acc_u[t]);
#endif
                }
            }
        }
#else
        uint rb = wbase + r * nb * 210u;
        for (uint u = lane; u < nb * 16u; u += LANES) {
            uint b = u >> 4;
            uint g = u & 15u;
            uint n = g >> 3;
            uint tq = (g >> 1) & 3u;
            uint h = g & 1u;
            uint at = rb + b * 210u;
            float d = unpackHalf2x16(word_at(at + 206u) >> 16u).x;
            float sc = float(bitfieldExtract(
                int(byte_at(at + 192u + n * 8u + h + 2u * tq)), 0, 8));
            uint ql = at + n * 64u + (tq & 1u) * 32u + h * 16u;
            uint qh = at + 128u + n * 32u + h * 16u;
            uint lsh = (tq >> 1) * 4u;
            uint hsh = 2u * tq;
            uint xi = xbase + b * 256u + n * 128u + tq * 32u + h * 16u;
            uint lw[4], hw[4];
            uint lsft = (ql & 3u) * 8u, hsft = (qh & 3u) * 8u;
            if (lsft == 0u) {
                for (uint k = 0u; k < 4u; ++k) {
                    lw[k] = w[(ql >> 2) + k];
                    hw[k] = w[(qh >> 2) + k];
                }
            } else {
                uint l0 = w[ql >> 2], h0 = w[qh >> 2];
                for (uint k = 0u; k < 4u; ++k) {
                    uint l1 = w[(ql >> 2) + k + 1u];
                    uint h1 = w[(qh >> 2) + k + 1u];
                    lw[k] = (l0 >> lsft) | (l1 << (32u - lsft));
                    hw[k] = (h0 >> hsft) | (h1 << (32u - hsft));
                    l0 = l1;
                    h0 = h1;
                }
            }
            // The 16 quants as floats once, then per token
            // matvec_q6_k.comp's sum.
            vec4 qv[4];
            for (uint k = 0u; k < 4u; ++k) {
                uint lo = lw[k] >> lsh;
                uint hi = hw[k] >> hsh;
                uint q4 = (lo & 0x0f0f0f0fu) | ((hi & 0x03030303u) << 4u);
                vec2 q02 = unpackHalf2x16((q4 & 0x003f003fu) | 0x64006400u);
                vec2 q13 = unpackHalf2x16(((q4 >> 8u) & 0x003f003fu) |
                                          0x64006400u);
                qv[k] = vec4(q02.x, q13.x, q02.y, q13.y) - 1056.0;
            }
            for (uint t = 0u; t < NT; ++t) {
                if (t < nt) {
                    uint xt = xi + t * pc.x_stride;
                    float s = 0.0;
                    for (uint k = 0u; k < 4u; ++k) {
                        s += dot(qv[k], xload(xt + k * 4u, xal));
                    }
                    acc[t] += d * sc * s;
                }
            }
        }
#endif
    }
    for (uint t = 0u; t < NT; ++t) {
        if (t < nt) {
            red[t * LANES * ROWS + tid] = acc[t];
#ifdef SWIGLU
            red_u[t * LANES * ROWS + tid] = acc_u[t];
#endif
        }
    }
    barrier();
    for (uint step = LANES / 2u; step > 0u; step >>= 1) {
        if (lane < step) {
            for (uint t = 0u; t < NT; ++t) {
                if (t < nt) {
                    uint i = t * LANES * ROWS + tid;
                    red[i] += red[i + step];
#ifdef SWIGLU
                    red_u[i] += red_u[i + step];
#endif
                }
            }
        }
        barrier();
    }
    // Lane t writes token t's output for this row.
    if (lane < nt && r < pc.rows) {
        float v = red[lane * LANES * ROWS + slot * LANES] * pc.scale;
        uint oi = pc.out_offset + bt * pc.out_bstride +
                  lane * pc.out_stride + r;
#ifdef SWIGLU
        // silu_mul.comp's formula on the gate and up outputs.
        float u = red_u[lane * LANES * ROWS + slot * LANES] * pc.scale;
        o[oi] = v / (1.0 + exp(-v)) * u;
#else
        o[oi] = pc.accumulate != 0u ? o[oi] + v : v;
#endif
    }
}
