# Writes OUT, a header with kComputeDigest: 8 hex digits of a SHA-256
# over what computes KV (the disk prefix key, i#1180): every file under
# src/locus (the kernels, the Metal kernels and the Vulkan shaders, the
# forward and the engine's prefill chunking) and CMakeLists.txt (each
# kernel variant's flags), each as its path relative to ROOT and its
# own SHA-256, in sorted order, then the build configuration in CONFIG
# (the compiler, build type and flags). A change to any of them changes
# the digest; the header is rewritten only when the digest changed.
#
#   cmake -DROOT=<source dir> -DCONFIG=<file> -DOUT=<header>
#         -P compute_digest.cmake

file(GLOB_RECURSE files LIST_DIRECTORIES false "${ROOT}/src/locus/*")
list(APPEND files "${ROOT}/CMakeLists.txt")
list(SORT files)
set(all "")
foreach(f IN LISTS files)
    file(SHA256 "${f}" h)
    file(RELATIVE_PATH rel "${ROOT}" "${f}")
    string(APPEND all "${rel} ${h}\n")
endforeach()
file(READ "${CONFIG}" config)
string(APPEND all "config\n${config}")
string(SHA256 digest "${all}")
string(SUBSTRING "${digest}" 0 8 digest)
set(text "#pragma once\n// Generated by cmake/compute_digest.cmake (i#1180).\n")
string(APPEND text "namespace locus::engine {\n")
string(APPEND text "/** 8 hex digits of what computes KV (sources and build). */\n")
string(APPEND text "inline constexpr const char* kComputeDigest = \"${digest}\";\n")
string(APPEND text "}  // namespace locus::engine\n")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
