# Anchored to the repo root so the CMake tree is ignored but a
# directory named "build" elsewhere (e.g. .claude/skills/build) is not.
/build/
/build-*/
.cache/
compile_commands.json
.DS_Store

# Large model files live outside the repo; these paths may be plain
# directories or symlinks to a big-disk location. No trailing slash
# so a symlink at the path is ignored too (a "dir/" pattern matches
# only real directories, not a symlink pointing at one).
tests/models
/models

# Internal Claude Code build skill: references the private multi-host
# setup (m2 / vx / pi), so it stays local on each host, out of git.
/.claude/skills/build/

# IDE files
.idea/
.vscode/
.vs/
*.swp
*.swo
.clangd/
cmake-build-*/
